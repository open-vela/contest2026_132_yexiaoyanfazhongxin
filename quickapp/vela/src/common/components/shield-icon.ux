<template>
  <div class="shield-container" onclick="onClick">
    <canvas ref="shieldCanvas" class="shield-canvas"></canvas>
    <div class="shield-badge" if="{{ badge }}">
      <text class="shield-badge-text">{{ badge }}</text>
    </div>
  </div>
</template>

<script>
/**
 * 盾牌图标组件
 *
 * 用于隐私状态展示，支持三种状态：
 * - unlocked: 破碎盾牌（未保护）
 * - half: 半满盾牌（部分保护）
 * - locked: 满盾+锁（完全保护）
 *
 * @module common/components/shield-icon
 */

export default {
  props: {
    status: { type: String, default: 'locked' },
    size: { type: Number, default: 80 },
    badge: { type: String, default: '' },
  },

  data() {
    return {
      ctx: null,
    }
  },

  onReady() {
    this._initCanvas()
    this._draw()
  },

  watch: {
    status() {
      this._draw()
    },
  },

  methods: {
    _initCanvas() {
      const canvas = this.$refs.shieldCanvas
      if (canvas) {
        this.ctx = canvas.getContext('2d')
        canvas.width = this.size
        canvas.height = this.size
      }
    },

    _draw() {
      if (!this.ctx) return
      const ctx = this.ctx
      const center = this.size / 2
      const scale = this.size / 80

      ctx.clearRect(0, 0, this.size, this.size)

      // 盾牌路径
      const shieldPath = this._getShieldPath(center, scale)

      // 根据状态绘制
      switch (this.status) {
        case 'unlocked':
          this._drawUnlocked(ctx, shieldPath, center, scale)
          break
        case 'half':
          this._drawHalf(ctx, shieldPath, center, scale)
          break
        case 'locked':
        default:
          this._drawLocked(ctx, shieldPath, center, scale)
          break
      }
    },

    _getShieldPath(center, scale) {
      // 盾牌形状路径
      return {
        top: center - 30 * scale,
        bottom: center + 35 * scale,
        left: center - 25 * scale,
        right: center + 25 * scale,
        tip: center + 40 * scale,
      }
    },

    _drawLocked(ctx, path, center, scale) {
      // 满盾 - 绿色
      ctx.beginPath()
      ctx.moveTo(path.left, path.top)
      ctx.lineTo(path.right, path.top)
      ctx.lineTo(path.right, center)
      ctx.quadraticCurveTo(path.right, path.bottom, center, path.tip)
      ctx.quadraticCurveTo(path.left, path.bottom, path.left, center)
      ctx.closePath()
      ctx.fillStyle = '#00C853'
      ctx.fill()
      ctx.strokeStyle = '#00A844'
      ctx.lineWidth = 2
      ctx.stroke()

      // 锁图标
      const lockY = center - 5 * scale
      const lockSize = 12 * scale

      // 锁身
      ctx.fillStyle = '#ffffff'
      ctx.fillRect(center - lockSize / 2, lockY, lockSize, lockSize * 0.8)

      // 锁环
      ctx.beginPath()
      ctx.arc(center, lockY, lockSize * 0.4, Math.PI, 0)
      ctx.strokeStyle = '#ffffff'
      ctx.lineWidth = 3 * scale
      ctx.stroke()
    },

    _drawHalf(ctx, path, center, scale) {
      // 半盾 - 黄色
      ctx.beginPath()
      ctx.moveTo(path.left, path.top)
      ctx.lineTo(path.right, path.top)
      ctx.lineTo(path.right, center)
      ctx.quadraticCurveTo(path.right, path.bottom, center, path.tip)
      ctx.quadraticCurveTo(path.left, path.bottom, path.left, center)
      ctx.closePath()

      // 渐变填充
      const gradient = ctx.createLinearGradient(path.left, path.top, path.right, path.bottom)
      gradient.addColorStop(0, '#FFD600')
      gradient.addColorStop(1, '#FFC107')
      ctx.fillStyle = gradient
      ctx.fill()
      ctx.strokeStyle = '#FFC107'
      ctx.lineWidth = 2
      ctx.stroke()

      // 半满效果
      ctx.beginPath()
      ctx.moveTo(center, path.top + 10 * scale)
      ctx.lineTo(center, path.tip - 5 * scale)
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.5)'
      ctx.lineWidth = 2
      ctx.stroke()
    },

    _drawUnlocked(ctx, path, center, scale) {
      // 破碎盾牌 - 红色
      ctx.beginPath()
      ctx.moveTo(path.left, path.top)
      ctx.lineTo(path.right, path.top)
      ctx.lineTo(path.right, center)
      ctx.quadraticCurveTo(path.right, path.bottom, center, path.tip)
      ctx.quadraticCurveTo(path.left, path.bottom, path.left, center)
      ctx.closePath()
      ctx.fillStyle = '#FF1744'
      ctx.fill()
      ctx.strokeStyle = '#D50000'
      ctx.lineWidth = 2
      ctx.stroke()

      // 破裂线
      ctx.beginPath()
      ctx.moveTo(center - 5 * scale, path.top + 15 * scale)
      ctx.lineTo(center + 3 * scale, center)
      ctx.lineTo(center - 2 * scale, center + 10 * scale)
      ctx.strokeStyle = '#ffffff'
      ctx.lineWidth = 2
      ctx.stroke()

      // 打开的锁
      const lockY = center - 5 * scale
      const lockSize = 10 * scale

      ctx.fillStyle = '#ffffff'
      ctx.fillRect(center - lockSize / 2, lockY, lockSize, lockSize * 0.7)

      // 打开的锁环
      ctx.beginPath()
      ctx.arc(center + 3 * scale, lockY, lockSize * 0.35, Math.PI * 0.8, Math.PI * 0.2)
      ctx.strokeStyle = '#ffffff'
      ctx.lineWidth = 2.5 * scale
      ctx.stroke()
    },

    onClick() {
      this.$emit('click')
    },
  },
}
</script>

<style>
.shield-container {
  width: 80px;
  height: 80px;
  justify-content: center;
  align-items: center;
}

.shield-canvas {
  width: 80px;
  height: 80px;
}

.shield-badge {
  position: absolute;
  top: 0;
  right: 0;
  background-color: #FF1744;
  border-radius: 10px;
  padding: 2px 6px;
}

.shield-badge-text {
  font-size: 10px;
  color: #ffffff;
  font-weight: bold;
}
</style>
