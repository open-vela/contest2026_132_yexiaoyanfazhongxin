<!--
  posture-result.ux - 姿态识别结果显示组件

  功能：
  - 显示当前识别出的姿态名称和图标
  - 显示置信度进度条
  - 显示推理耗时
  - 摔倒时高亮警告

  属性：
  - postureId: 当前姿态ID (0-4)
  - confidence: 置信度 (0-1)
  - inferenceTime: 推理耗时(ms)
  - isRunning: 模型是否运行中
-->
<template>
  <div class="posture-panel">
    <!-- 标题 -->
    <div class="panel-header">
      <text class="panel-title">🧠 姿态识别</text>
      <text class="run-status {{isRunning ? 'running' : 'stopped'}}">
        {{isRunning ? '运行中' : '已停止'}}
      </text>
    </div>

    <!-- 姿态显示区域 -->
    <div class="posture-display">
      <!-- 姿态图标 -->
      <text class="posture-icon">{{postureIcon}}</text>
      <!-- 姿态名称 -->
      <text class="posture-name {{alertClass}}">{{postureName}}</text>
    </div>

    <!-- 置信度条 -->
    <div class="confidence-section">
      <div class="confidence-header">
        <text class="confidence-label">置信度</text>
        <text class="confidence-value">{{confidencePercent}}%</text>
      </div>
      <div class="confidence-bar-bg">
        <div class="confidence-bar-fill {{confidenceColor}}"
             style="width: {{confidenceWidth}}px"></div>
      </div>
    </div>

    <!-- 推理信息 -->
    <div class="inference-info">
      <text class="info-text">推理: {{inferenceTime}}ms</text>
      <text class="info-text">参数: {{paramCount}}</text>
    </div>
  </div>
</template>

<script>
/**
 * 姿态结果显示组件
 */
export default {
  props: {
    // 当前姿态ID
    postureId: {
      type: Number,
      default: -1
    },
    // 置信度 (0-1)
    confidence: {
      type: Number,
      default: 0
    },
    // 推理耗时(ms)
    inferenceTime: {
      type: Number,
      default: 0
    },
    // 模型是否运行
    isRunning: {
      type: Boolean,
      default: false
    }
  },

  computed: {
    // 姿态名称映射
    postureName: function () {
      var labels = {
        0: '🧍 站立',
        1: '🪑 坐下',
        2: '🚶 行走',
        3: '🖐️ 抬手',
        4: '⚠️ 摔倒'
      };
      return labels[this.postureId] || '❓ 未知';
    },

    // 姿态图标（纯emoji）
    postureIcon: function () {
      var icons = { 0: '🧍', 1: '🪑', 2: '🚶', 3: '🖐️', 4: '⚠️' };
      return icons[this.postureId] || '❓';
    },

    // 置信度百分比
    confidencePercent: function () {
      return Math.round(this.confidence * 100);
    },

    // 置信度条宽度 (最大140px)
    confidenceWidth: function () {
      return Math.round(this.confidence * 140);
    },

    // 置信度颜色
    confidenceColor: function () {
      if (this.confidence >= 0.8) return 'conf-high';
      if (this.confidence >= 0.5) return 'conf-medium';
      return 'conf-low';
    },

    // 警告样式（摔倒时高亮）
    alertClass: function () {
      if (this.postureId === 4) return 'alert-danger';
      if (this.postureId === 3) return 'alert-warning';
      return '';
    },

    // 模型参数量显示
    paramCount: function () {
      return '~6.5K';
    }
  }
}
</script>

<style>
/* 面板容器 */
.posture-panel {
  flex-direction: column;
  background-color: #1a1a2e;
  border-radius: 12px;
  padding: 10px;
  margin-bottom: 8px;
  width: 92%;
}

/* 标题栏 */
.panel-header {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.panel-title {
  font-size: 14px;
  color: #e0e0e0;
  font-weight: bold;
}

.run-status {
  font-size: 10px;
  padding: 2px 8px;
  border-radius: 8px;
}

.run-status.running {
  color: #4CAF50;
  background-color: #1b3a1b;
}

.run-status.stopped {
  color: #888888;
  background-color: #2a2a2a;
}

/* 姿态显示区域 */
.posture-display {
  flex-direction: column;
  align-items: center;
  margin-bottom: 10px;
  padding: 8px 0;
}

.posture-icon {
  font-size: 36px;
  margin-bottom: 4px;
}

.posture-name {
  font-size: 20px;
  color: #ffffff;
  font-weight: bold;
}

/* 警告样式 */
.alert-danger {
  color: #FF5252 !important;
}

.alert-warning {
  color: #FFB74D !important;
}

/* 置信度条 */
.confidence-section {
  flex-direction: column;
  margin-bottom: 8px;
}

.confidence-header {
  flex-direction: row;
  justify-content: space-between;
  margin-bottom: 4px;
}

.confidence-label {
  font-size: 11px;
  color: #888888;
}

.confidence-value {
  font-size: 11px;
  color: #cccccc;
}

.confidence-bar-bg {
  height: 8px;
  background-color: #2a2a3e;
  border-radius: 4px;
  width: 140px;
}

.confidence-bar-fill {
  height: 8px;
  border-radius: 4px;
}

.conf-high { background-color: #4CAF50; }
.conf-medium { background-color: #FFB74D; }
.conf-low { background-color: #FF5252; }

/* 推理信息 */
.inference-info {
  flex-direction: row;
  justify-content: space-between;
  padding-top: 4px;
  border-top-width: 1px;
  border-top-color: #333344;
}

.info-text {
  font-size: 10px;
  color: #666666;
}
</style>
