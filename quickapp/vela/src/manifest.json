{
  "package": "com.openvela.posture.guard",
  "name": "体态安全卫士",
  "versionName": "1.0.0",
  "versionCode": 1,
  "minPlatformVersion": 1000,
  "icon": "/common/logo.png",
  "simulationVersion": "default",
  "deviceTypeList": [
    "watch"
  ],
  "features": [
    { "name": "system.router" },
    { "name": "system.prompt" },
    { "name": "system.storage" },
    { "name": "system.sensor" },
    { "name": "system.vibrator" },
    { "name": "system.crypto" },
    { "name": "system.configuration" },
    { "name": "service.health" }
  ],
  "config": {
    "logLevel": "debug",
    "designWidth": 480,
    "background": {
      "features": [
        "system.sensor",
        "service.health"
      ]
    }
  },
  "router": {
    "entry": "pages/index",
    "pages": {
      "pages/index": {
        "component": "index"
      },
      "pages/history": {
        "component": "history"
      },
      "pages/settings": {
        "component": "settings"
      }
    }
  }
}
