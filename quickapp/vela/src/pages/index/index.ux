  font-size: 10px;
  color: #2979FF;
  background-color: rgba(41, 121, 255, 0.15);
  padding: 2px 8px;
  border-radius: 8px;
  margin-right: 6px;
}

.mock-badge {
  font-size: 10px;
  color: #FFD600;
  background-color: rgba(255, 214, 0, 0.15);
  padding: 2px 8px;
  border-radius: 8px;
}

