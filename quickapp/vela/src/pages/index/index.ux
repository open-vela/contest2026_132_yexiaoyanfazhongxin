<template>
  <div class="page">
    <!-- 顶部系统状态 -->
    <div class="top-bar">
      <div class="status-dot {{ systemStatus }}"></div>
      <text class="status-text">{{ systemStatusText }}</text>
      <text class="mock-badge" if="{{ mockMode }}">Mock</text>
    </div>

    <!-- 健康评分区 -->
    <div class="score-section">
      <text class="score-value {{ healthScoreClass }}">{{ healthScore }}</text>
      <text class="score-label">健康评分</text>
    </div>

    <!-- 当前体态状态 -->
    <div class="posture-card">
      <text class="posture-emoji">{{ currentPostureIcon }}</text>
      <div class="posture-info">
        <text class="posture-type">{{ currentPostureType }}</text>
        <text class="posture-detail">置信度 {{ currentConfidence }}% · {{ currentDuration }}秒</text>
      </div>
    </div>

    <!-- 今日异常统计 -->
    <div class="stats-row">
      <div class="stat-item" for="{{ todayAnomalies }}">
        <text class="stat-icon">{{ $item.icon }}</text>
        <text class="stat-count">{{ $item.count }}</text>
        <text class="stat-name">{{ $item.name }}</text>
      </div>
    </div>

    <!-- Mock 场景切换 -->
    <div class="mock-section">
      <text class="section-label">模拟场景</text>
      <div class="mock-btns">
        <div class="mock-btn {{ currentScenario === 'normal' ? 'active' : '' }}"
             onclick="switchScenario('normal')">
          <text class="mock-btn-text">😊 正常</text>
        </div>
        <div class="mock-btn {{ currentScenario === 'sedentary' ? 'active' : '' }}"
             onclick="switchScenario('sedentary')">
          <text class="mock-btn-text">🪑 久坐</text>
        </div>
        <div class="mock-btn {{ currentScenario === 'headDown' ? 'active' : '' }}"
             onclick="switchScenario('headDown')">
          <text class="mock-btn-text">📱 低头</text>
        </div>
        <div class="mock-btn {{ currentScenario === 'crossLeg' ? 'active' : '' }}"
             onclick="switchScenario('crossLeg')">
          <text class="mock-btn-text">🦵 跷腿</text>
        </div>
      </div>
    </div>

    <!-- 加密状态 -->
    <div class="encrypt-bar">
      <text class="encrypt-icon">🔐</text>
      <text class="encrypt-text">数据已加密 · AES-{{ encryptLevel }} · {{ encryptedFiles }}个文件</text>
    </div>

    <!-- 底部导航栏 -->
    <div class="bottom-nav">
      <div class="nav-item active" onclick="goTo('index')">
        <text class="nav-icon">🏠</text>
        <text class="nav-label nav-label-active">首页</text>
      </div>
      <div class="nav-item" onclick="goTo('posture')">
        <text class="nav-icon">🏃</text>
        <text class="nav-label">体态</text>
      </div>
      <div class="nav-item" onclick="goTo('privacy')">
        <text class="nav-icon">🛡️</text>
        <text class="nav-label">隐私</text>
      </div>
      <div class="nav-item" onclick="goTo('report')">
        <text class="nav-icon">📊</text>
        <text class="nav-label">报表</text>
      </div>
      <div class="nav-item" onclick="goTo('settings')">
        <text class="nav-icon">⚙️</text>
        <text class="nav-label">设置</text>
      </div>
    </div>
  </div>
</template>

<script>
/**
 * 首页仪表盘
 *
 * 功能：
 * - 健康评分实时展示
 * - 当前体态状态（图标+名称+置信度+持续时间）
 * - 今日异常统计（久坐/低头/跷腿次数）
 * - Mock 场景快速切换
 * - 加密状态展示
 * - 底部导航栏
 */

import router from '@system.router'
import prompt from '@system.prompt'
import { PostureEngine } from '../../core/posture-engine'
import { getPostureName, getPostureIcon } from '../../common/constants/postures'
import { SecureStorage } from '../../storage/secure-storage'
import { SensorMock } from '../../common/utils/sensor-mock'

export default {
  private: {
    // 系统状态
    systemStatus: 'ok',
    systemStatusText: '系统正常',

    // 健康评分
    healthScore: 85,
    healthScoreClass: 'score-good',

    // 当前体态
    currentPostureIcon: '⏳',
    currentPostureType: '等待数据...',
    currentConfidence: 0,
    currentDuration: 0,

    // 今日统计
    todayAnomalies: [
      { icon: '🪑', name: '久坐', count: 0, type: 'sedentary' },
      { icon: '📱', name: '低头', count: 0, type: 'forward_tilt' },
      { icon: '🦵', name: '跷腿', count: 0, type: 'cross_leg' },
    ],

    // Mock 场景
    currentScenario: 'normal',
    mockMode: true,

    // 加密状态
    encryptLevel: '128-GCM',
    encryptedFiles: 0,

    // 引擎实例
    engine: null,
    secureStorage: null,
    sensorMock: null,

    // 定时器
    refreshTimer: null,
    postureTimer: null,
  },

  onReady() {
    console.log('[Index] onReady')
    this._initModules()
    this._startAutoRefresh()
  },

  onDestroy() {
    console.log('[Index] onDestroy')
    if (this.engine) this.engine.stop()
    if (this.refreshTimer) clearInterval(this.refreshTimer)
    if (this.postureTimer) clearInterval(this.postureTimer)
  },

  /**
   * 初始化所有模块
   * @private
   */
  async _initModules() {
    try {
      // 1. 初始化安全存储
      this.secureStorage = new SecureStorage()
      await this.secureStorage.init({
        deviceId: 'mock-device-001',
        userPin: '1234',
      })

      // 2. 初始化体态引擎
      this.engine = new PostureEngine({ sampleRate: 50, windowSize: 250 })
      await this.engine.init()

      // 3. 创建 Mock 传感器适配器（实现 onData 接口）
      const mockSensorAdapter = {
        dataCallback: null,
        onData(callback) {
          this.dataCallback = callback
        },
        emit(data) {
          if (this.dataCallback) this.dataCallback(data)
        },
      }
      this.engine.sensorInterface = mockSensorAdapter

      // 4. 设置引擎回调
      this.engine.onResult = (filterResult, features) => {
        this._onPostureResult(filterResult, features)
      }
      this.engine.onEvent = (eventType, event) => {
        this._onAlertEvent(eventType, event)
      }

      // 5. 初始化 Mock 场景管理器
      this.sensorMock = new SensorMock()

      // 6. 注入默认场景并启动
      this.sensorMock.injectScenario('mixed-daily')
      this.currentScenario = 'mixed-daily'

      // 7. 启动引擎（Mock模式）
      this.engine.start({ mockMode: true })
      this._startMockStream()

      // 7. 加载存储统计
      this._loadStorageStats()

      this._updateSystemStatus('ok')
      console.log('[Index] All modules initialized')
    } catch (error) {
      console.error('[Index] Init failed:', error)
      this._updateSystemStatus('error')
    }
  },

  /**
   * 启动 Mock 数据流
   * @private
   */
  _startMockStream() {
    if (!this.sensorMock) return

    this.sensorMock.startStream((data) => {
      // 将 Mock 数据输入引擎
      if (this.engine && this.engine.sensorInterface) {
        this.engine.sensorInterface.emit(data)
      }
    })

    console.log('[Index] Mock stream started')
  },

  /**
   * 切换 Mock 场景
   * @param {string} scenario - 场景名称
   */
  switchScenario(scenario) {
    // 场景名称映射
    const scenarioMap = {
      'normal': 'mixed-daily',
      'sedentary': 'sedentary-2h',
      'headDown': 'office-work-1h',
      'crossLeg': 'cross-leg-30m',
    }

    const mappedScenario = scenarioMap[scenario] || scenario

    if (this.sensorMock) {
      this.sensorMock.stopStream()
      this.sensorMock.injectScenario(mappedScenario)
      this.sensorMock.startStream((data) => {
        if (this.engine && this.engine.sensorInterface) {
          this.engine.sensorInterface.emit(data)
        }
      })
    }

    this.currentScenario = scenario
    prompt.showToast({ message: `已切换到${getPostureName(scenario) || scenario}场景` })
  },

  /**
   * 加载存储统计
   * @private
   */
  async _loadStorageStats() {
    try {
      const stats = await this.secureStorage.getStats()
      if (stats) {
        this.encryptedFiles = stats.totalFiles || 0
      }
    } catch (e) {
      console.log('[Index] Storage stats not available')
    }
  },

  /**
   * 体态识别结果回调
   * @private
   */
  _onPostureResult(filterResult, features) {
    this.currentPostureIcon = getPostureIcon(filterResult.posture)
    this.currentPostureType = getPostureName(filterResult.posture)
    this.currentConfidence = Math.round(filterResult.confidence * 100)
    this.currentDuration = Math.round(filterResult.duration)

    // 更新健康评分
    if (filterResult.posture !== POSTURE_TYPE.NORMAL && filterResult.confirmed) {
      this.healthScore = Math.max(0, this.healthScore - 1)
    } else if (filterResult.posture === POSTURE_TYPE.NORMAL) {
      this.healthScore = Math.min(100, this.healthScore + 0.3)
    }
    this._updateScoreClass()
  },

  /**
   * 提醒事件回调
   * @private
   */
  _onAlertEvent(eventType, event) {
    if (!event || !event.posture) return

    // 更新对应类型的计数
    for (let i = 0; i < this.todayAnomalies.length; i++) {
      if (this.todayAnomalies[i].type === event.posture) {
        this.todayAnomalies[i].count++
        break
      }
    }
  },

  /**
   * 更新评分颜色
   * @private
   */
  _updateScoreClass() {
    if (this.healthScore >= 80) {
      this.healthScoreClass = 'score-good'
    } else if (this.healthScore >= 60) {
      this.healthScoreClass = 'score-warn'
    } else {
      this.healthScoreClass = 'score-danger'
    }
  },

  /**
   * 更新系统状态
   * @private
   */
  _updateSystemStatus(status) {
    this.systemStatus = status
    this.systemStatusText = status === 'ok' ? '系统正常' : '系统异常'
  },

  /**
   * 自动刷新
   * @private
   */
  _startAutoRefresh() {
    this.refreshTimer = setInterval(() => {
      this._loadStorageStats()
    }, 30000)
  },

  /**
   * 页面导航
   * @param {string} page - 页面名称
   */
  goTo(page) {
    if (page === 'index') return
    router.push({ uri: `/pages/${page}/${page}` })
  },
}
</script>

<style>
.page {
  flex-direction: column;
  width: 480px;
  height: 480px;
  background-color: #0a0a0a;
}

/* 顶部状态栏 */
.top-bar {
  width: 100%;
  flex-direction: row;
  align-items: center;
  padding: 8px 16px;
  background-color: #1a1a2e;
}

.status-dot {
  width: 8px;
  height: 8px;
  border-radius: 4px;
  margin-right: 6px;
}

.status-dot.ok { background-color: #00C853; }
.status-dot.error { background-color: #FF1744; }

.status-text {
  font-size: 11px;
  color: #888888;
  flex: 1;
}

.mock-badge {
  font-size: 10px;
  color: #FFD600;
  background-color: rgba(255, 214, 0, 0.15);
  padding: 2px 8px;
  border-radius: 8px;
}

/* 健康评分 */
.score-section {
  flex-direction: column;
  align-items: center;
  padding: 12px 0 8px;
}

.score-value {
  font-size: 52px;
  font-weight: bold;
}

.score-good { color: #00C853; }
.score-warn { color: #FFD600; }
.score-danger { color: #FF1744; }

.score-label {
  font-size: 13px;
  color: #888888;
  margin-top: -4px;
}

/* 当前体态 */
.posture-card {
  flex-direction: row;
  align-items: center;
  margin: 0 16px 8px;
  padding: 10px 14px;
  background-color: #1a1a2e;
  border-radius: 10px;
}

.posture-emoji {
  font-size: 28px;
  margin-right: 12px;
}

.posture-info {
  flex: 1;
  flex-direction: column;
}

.posture-type {
  font-size: 16px;
  color: #ffffff;
  font-weight: bold;
}

.posture-detail {
  font-size: 11px;
  color: #888888;
  margin-top: 2px;
}

/* 统计行 */
.stats-row {
  flex-direction: row;
  justify-content: space-around;
  margin: 0 16px 8px;
}

.stat-item {
  flex-direction: column;
  align-items: center;
  background-color: #1a1a2e;
  border-radius: 8px;
  padding: 8px 16px;
  width: 30%;
}

.stat-icon {
  font-size: 18px;
  margin-bottom: 4px;
}

.stat-count {
  font-size: 20px;
  color: #ffffff;
  font-weight: bold;
}

.stat-name {
  font-size: 11px;
  color: #888888;
}

/* Mock 场景切换 */
.mock-section {
  margin: 0 16px 8px;
  padding: 10px;
  background-color: #1a1a2e;
  border-radius: 10px;
}

.section-label {
  font-size: 12px;
  color: #666666;
  margin-bottom: 8px;
}

.mock-btns {
  flex-direction: row;
  justify-content: space-between;
}

.mock-btn {
  padding: 6px 10px;
  background-color: #2a2a4e;
  border-radius: 8px;
  align-items: center;
  justify-content: center;
}

.mock-btn.active {
  background-color: #2979FF;
}

.mock-btn-text {
  font-size: 12px;
  color: #ffffff;
}

/* 加密状态 */
.encrypt-bar {
  flex-direction: row;
  align-items: center;
  margin: 0 16px 8px;
  padding: 8px 12px;
  background-color: #0d3320;
  border-radius: 8px;
}

.encrypt-icon {
  font-size: 14px;
  margin-right: 8px;
}

.encrypt-text {
  font-size: 11px;
  color: #4CAF50;
}

/* 底部导航 */
.bottom-nav {
  flex: 1;
  flex-direction: row;
  justify-content: space-around;
  align-items: center;
  background-color: #1a1a2e;
  border-top-width: 1px;
  border-top-color: #2a2a4e;
}

.nav-item {
  flex-direction: column;
  align-items: center;
  padding: 6px 12px;
}

.nav-label-active {
  color: #2979FF;
}

.nav-icon {
  font-size: 20px;
}

.nav-label {
  font-size: 10px;
  color: #888888;
  margin-top: 2px;
}
</style>
