<template>
  <div class="page">
    <!-- 顶部状态栏 -->
    <div class="top-bar">
      <div class="status-dot {{ systemStatus }}"></div>
      <text class="status-text">{{ systemStatusText }}</text>
      <text class="model-badge">{{ modelType }}</text>
      <text class="mock-badge" if="{{ mockMode }}">Mock</text>
    </div>

    <!-- 健康评分区 -->
    <div class="score-section">
      <text class="score-value {{ scoreClass }}">{{ healthScore }}</text>
      <text class="score-label">健康评分</text>
    </div>

    <!-- 当前体态状态 -->
    <div class="posture-card">
      <text class="posture-emoji">{{ currentIcon }}</text>
      <div class="posture-info">
        <text class="posture-type">{{ currentPosture }}</text>
        <text class="posture-detail">置信度 {{ confidence }}% · {{ motionState === 'active' ? '活动中' : '静止中' }}</text>
      </div>
      <div class="motion-dot {{ motionState }}"></div>
    </div>

    <!-- 实时数据面板 -->
    <div class="data-panel">
      <div class="data-row">
        <text class="data-label">推理间隔</text>
        <text class="data-value">{{ inferInterval }}ms</text>
      </div>
      <div class="data-row">
        <text class="data-label">采样率</text>
        <text class="data-value">{{ sampleRate }}Hz</text>
      </div>
      <div class="data-row">
        <text class="data-label">缓冲区</text>
        <text class="data-value">{{ bufferCount }}/500</text>
      </div>
      <div class="data-row">
        <text class="data-label">功耗模式</text>
        <text class="data-value">{{ powerMode }}</text>
      </div>
    </div>

    <!-- Mock 场景切换 -->
    <div class="mock-section">
      <text class="section-label">模拟场景</text>
      <div class="mock-btns">
        <div class="mock-btn {{ currentScenario === 'standard_sit' ? 'active' : '' }}"
             onclick="switchScenario('standard_sit')">
          <text class="mock-btn-text">🪑 坐姿</text>
        </div>
        <div class="mock-btn {{ currentScenario === 'hunched_sit' ? 'active' : '' }}"
             onclick="switchScenario('hunched_sit')">
          <text class="mock-btn-text">😮‍💨 驼背</text>
        </div>
        <div class="mock-btn {{ currentScenario === 'walking' ? 'active' : '' }}"
             onclick="switchScenario('walking')">
          <text class="mock-btn-text">🚶 行走</text>
        </div>
        <div class="mock-btn {{ currentScenario === 'running' ? 'active' : '' }}"
             onclick="switchScenario('running')">
          <text class="mock-btn-text">🏃 跑步</text>
        </div>
      </div>
    </div>

    <!-- 底部导航栏 -->
    <div class="bottom-nav">
      <div class="nav-item active" onclick="goTo('index')">
        <text class="nav-icon">🏠</text>
        <text class="nav-label">首页</text>
      </div>
      <div class="nav-item" onclick="goTo('history')">
        <text class="nav-icon">📊</text>
        <text class="nav-label">历史</text>
      </div>
      <div class="nav-item" onclick="goTo('settings')">
        <text class="nav-icon">⚙️</text>
        <text class="nav-label">设置</text>
      </div>
    </div>
  </div>
</template>

<script>
/**
 * 首页仪表盘
 *
 * 集成新的 AI Feature 接口，展示实时体态识别结果。
 * 支持 Mock 场景切换和自适应推理频率展示。
 */

import router from '@system.router'
import { aiPose } from '../../ai/ai-pose-feature'
import { PRESET_SCENARIOS, POSE_TYPE, IMUScenarioGenerator } from '../../mock/imu-scenarios'
import { POSE_NAME, POSE_ICON } from '../../ai/pose-model'
import { PowerManager, POWER_MODE } from '../../power/power-manager'

export default {
  private: {
    // 系统状态
    systemStatus: 'ok',
    systemStatusText: '系统正常',

    // 健康评分
    healthScore: 85,
    scoreClass: 'score-good',

    // 当前体态
    currentIcon: '⏳',
    currentPosture: '等待数据...',
    confidence: 0,
    motionState: 'static',

    // 推理状态
    inferInterval: 5000,
    sampleRate: 50,
    bufferCount: 0,
    powerMode: '正常',

    // Mock
    mockMode: true,
    currentScenario: 'standard_sit',
    modelType: 'static_cnn',

    // 引擎
    _powerManager: null,
    _refreshTimer: null,
  },

  onReady() {
    console.log('[Index] onReady')
    this._powerManager = new PowerManager()
    this._powerManager.onModeChange((newMode) => {
      const cfg = this._powerManager.getCurrentConfig()
      this.inferInterval = cfg.inferInterval
      this.sampleRate = cfg.sampleRate
      this.powerMode = cfg.description
    })
    this._initAI()
  },

  onDestroy() {
    aiPose.stopRecognition()
    if (this._refreshTimer) clearInterval(this._refreshTimer)
  },

  async _initAI() {
    const mockSource = PRESET_SCENARIOS['office-1h']()

    const ok = await aiPose.init({
      modelType: 'static_cnn',
      mockSource: mockSource,
    })

    if (!ok) {
      this._updateStatus('error')
      return
    }

    // 启动识别
    aiPose.startRecognition({
      success: (result) => this._onResult(result),
      fail: (err) => {
        console.error('[Index] Recognition failed:', err)
        this._updateStatus('error')
      },
    })

    // 定时刷新状态
    this._refreshTimer = setInterval(() => {
      this._refreshStatus()
    }, 1000)

    this._updateStatus('ok')
  },

  _onResult(result) {
    this.currentIcon = POSE_ICON[result.pose] || '❓'
    this.currentPosture = POSE_NAME[result.pose] || '未知'
    this.confidence = Math.round(result.confidence * 100)
    this.motionState = result.confidence > 0.7 ? 'active' : 'static'

    // 更新健康评分
    if (result.pose !== POSE_TYPE.STANDARD_SIT && result.pose !== POSE_TYPE.STANDARD_STAND) {
      this.healthScore = Math.max(0, this.healthScore - 0.5)
    } else {
      this.healthScore = Math.min(100, this.healthScore + 0.2)
    }
    this._updateScoreClass()
  },

  _refreshStatus() {
    const pose = aiPose.getCurrentPose()
    if (pose) {
      this.confidence = Math.round(pose.confidence * 100)
    }
  },

  switchScenario(type) {
    const generator = new IMUScenarioGenerator(type)
    aiPose.setMockSource(generator)
    aiPose.stopRecognition()
    aiPose.startRecognition({
      success: (result) => this._onResult(result),
    })
    this.currentScenario = type
  },

  _updateScoreClass() {
    if (this.healthScore >= 80) this.scoreClass = 'score-good'
    else if (this.healthScore >= 60) this.scoreClass = 'score-warn'
    else this.scoreClass = 'score-danger'
  },

  _updateStatus(status) {
    this.systemStatus = status
    this.systemStatusText = status === 'ok' ? '系统正常' : '系统异常'
  },

  goTo(page) {
    router.push({ uri: `/pages/${page}/${page}` })
  },
}
</script>

<style>
.page {
  flex-direction: column;
  width: 480px;
  height: 480px;
  background-color: #0a0a0a;
}

.top-bar {
  width: 100%;
  flex-direction: row;
  align-items: center;
  padding: 6px 12px;
  background-color: #1a1a2e;
}

