  flex-direction: column;
  align-items: center;
  padding: 8px 0 4px;
}

.score-value {
  font-size: 48px;
  font-weight: bold;
}

.score-good { color: #00C853; }
.score-warn { color: #FFD600; }
.score-danger { color: #FF1744; }

.score-label {
  font-size: 12px;
  color: #888888;
}

.posture-card {
  flex-direction: row;
  align-items: center;
  margin: 0 12px 6px;
  padding: 10px 14px;
  background-color: #1a1a2e;
  border-radius: 10px;
}

.posture-emoji {
  font-size: 28px;
  margin-right: 12px;
}

.posture-info {
  flex: 1;
  flex-direction: column;
}

.posture-type {
  font-size: 16px;
  color: #ffffff;
  font-weight: bold;
}

.posture-detail {
  font-size: 11px;
  color: #888888;
  margin-top: 2px;
}

.motion-dot {
  width: 10px;
  height: 10px;
  border-radius: 5px;
}

.motion-dot.active { background-color: #00C853; }
.motion-dot.static { background-color: #FF9800; }

.data-panel {
  margin: 0 12px 6px;
  padding: 8px 12px;
  background-color: #1a1a2e;
  border-radius: 8px;
}

.data-row {
  flex-direction: row;
  justify-content: space-between;
  padding: 3px 0;
}

.data-label {
  font-size: 11px;
  color: #666666;
}

.data-value {
  font-size: 11px;
  color: #ffffff;
}

.mock-section {
  margin: 0 12px 6px;
  padding: 8px 10px;
  background-color: #1a1a2e;
  border-radius: 8px;
}

.section-label {
  font-size: 11px;
  color: #666666;
  margin-bottom: 6px;
}

.mock-btns {
  flex-direction: row;
  justify-content: space-between;
}

.mock-btn {
  padding: 5px 8px;
  background-color: #2a2a4e;
  border-radius: 6px;
  align-items: center;
  justify-content: center;
}

.mock-btn.active {
  background-color: #2979FF;
}

.mock-btn-text {
  font-size: 11px;
  color: #ffffff;
}

.bottom-nav {
  flex: 1;
  flex-direction: row;
  justify-content: space-around;
  align-items: center;
  background-color: #1a1a2e;
  border-top-width: 1px;
  border-top-color: #2a2a4e;
}

.nav-item {
  flex-direction: column;
  align-items: center;
  padding: 4px 12px;
}

.nav-item.active .nav-label {
  color: #2979FF;
}

