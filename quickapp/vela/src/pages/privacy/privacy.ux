<template>
  <div class="page">
    <!-- 顶部导航 -->
    <div class="header">
      <div class="back-btn" onclick="goBack">
        <text class="back-icon">←</text>
      </div>
      <text class="title">隐私中心</text>
      <div class="encrypt-badge" onclick="showEncryptInfo">
        <text class="encrypt-badge-text">🔐 {{ encryptLevel }}</text>
      </div>
    </div>

    <!-- 隐私评分卡 -->
    <div class="score-card">
      <text class="score-icon">🛡️</text>
      <div class="score-info">
        <text class="score-value">92</text>
        <text class="score-label">隐私安全评分</text>
      </div>
      <div class="score-details">
        <text class="score-detail">已加密 {{ encryptedFiles }} 个文件</text>
        <text class="score-detail">脱敏率 {{ desensitizeRate }}%</text>
      </div>
    </div>

    <!-- 数据流展示：原始 → 脱敏 → 加密 -->
    <div class="flow-card">
      <div class="card-header">
        <text class="card-title">数据处理流程</text>
      </div>
      <div class="flow-row">
        <div class="flow-step">
          <text class="flow-icon">📡</text>
          <text class="flow-label">原始数据</text>
          <text class="flow-count">{{ rawCount }}条</text>
        </div>
        <text class="flow-arrow">→</text>
        <div class="flow-step">
          <text class="flow-icon">🔒</text>
          <text class="flow-label">差分隐私</text>
          <text class="flow-count">ε=0.1</text>
        </div>
        <text class="flow-arrow">→</text>
        <div class="flow-step">
          <text class="flow-icon">🔐</text>
          <text class="flow-label">AES加密</text>
          <text class="flow-count">{{ encryptLevel }}</text>
        </div>
      </div>
    </div>

    <!-- 数据生命周期仪表盘 -->
    <div class="lifecycle-card">
      <div class="card-header">
        <text class="card-title">数据生命周期</text>
      </div>
      <div class="lifecycle-row">
        <div class="lifecycle-stage hot">
          <text class="lifecycle-icon">🔥</text>
          <text class="lifecycle-name">热数据</text>
          <text class="lifecycle-count">{{ hotCount }}</text>
          <text class="lifecycle-time">24h</text>
        </div>
        <div class="lifecycle-stage warm">
          <text class="lifecycle-icon">🌡️</text>
          <text class="lifecycle-name">温数据</text>
          <text class="lifecycle-count">{{ warmCount }}</text>
          <text class="lifecycle-time">1-7d</text>
        </div>
        <div class="lifecycle-stage cold">
          <text class="lifecycle-icon">❄️</text>
          <text class="lifecycle-name">冷数据</text>
          <text class="lifecycle-count">{{ coldCount }}</text>
          <text class="lifecycle-time">7-30d</text>
        </div>
        <div class="lifecycle-stage destroyed">
          <text class="lifecycle-icon">🗑️</text>
          <text class="lifecycle-name">已销毁</text>
          <text class="lifecycle-count">{{ destroyedCount }}</text>
          <text class="lifecycle-time">永久</text>
        </div>
      </div>
    </div>

    <!-- 审计日志时间线 -->
    <div class="audit-card">
      <div class="card-header">
        <text class="card-title">安全审计日志</text>
      </div>
      <div class="audit-scroll">
        <div class="audit-item" for="{{ auditLogs }}">
          <div class="audit-dot {{ $item.type }}"></div>
          <div class="audit-content">
            <text class="audit-time">{{ $item.time }}</text>
            <text class="audit-message">{{ $item.message }}</text>
          </div>
        </div>
      </div>
    </div>

    <!-- 加密级别说明 -->
    <div class="levels-card">
      <div class="card-header">
        <text class="card-icon">📊</text>
        <text class="card-title">加密级别说明</text>
      </div>
      <div class="level-row">
        <div class="level-item">
          <div class="level-badge l1"><text class="level-badge-text">L1</text></div>
          <div class="level-info">
            <text class="level-name">AES-128-GCM</text>
            <text class="level-desc">30天留存</text>
          </div>
        </div>
        <div class="level-item">
          <div class="level-badge l2"><text class="level-badge-text">L2</text></div>
          <div class="level-info">
            <text class="level-name">AES-256-GCM</text>
            <text class="level-desc">7天留存</text>
          </div>
        </div>
        <div class="level-item">
          <div class="level-badge l3"><text class="level-badge-text">L3</text></div>
          <div class="level-info">
            <text class="level-name">AES-256+Shamir</text>
            <text class="level-desc">24h强制销毁</text>
          </div>
        </div>
      </div>
    </div>

    <!-- 底部导航 -->
    <div class="bottom-nav">
      <div class="nav-item" onclick="goTo('index')">
        <text class="nav-icon">🏠</text>
        <text class="nav-label">首页</text>
      </div>
      <div class="nav-item" onclick="goTo('posture')">
        <text class="nav-icon">🏃</text>
        <text class="nav-label">体态</text>
      </div>
      <div class="nav-item active">
        <text class="nav-icon">🛡️</text>
        <text class="nav-label nav-label-active">隐私</text>
      </div>
      <div class="nav-item" onclick="goTo('report')">
        <text class="nav-icon">📊</text>
        <text class="nav-label">报表</text>
      </div>
      <div class="nav-item" onclick="goTo('settings')">
        <text class="nav-icon">⚙️</text>
        <text class="nav-label">设置</text>
      </div>
    </div>
  </div>
</template>

<script>
/**
 * 隐私中心页
 *
 * 功能：
 * - 隐私安全评分
 * - 数据处理流程可视化（原始→脱敏→加密）
 * - 数据生命周期仪表盘（热/温/冷/销毁）
 * - 安全审计日志时间线
 * - 加密级别说明（L1/L2/L3）
 * - 底部导航
 */

import router from '@system.router'
import prompt from '@system.prompt'
import { LifecycleManager } from '../../privacy/lifecycle-manager'
import { SecureStorage } from '../../storage/secure-storage'
import { eventBus } from '../../common/event-bus'

export default {
  private: {
    // 加密状态
    encryptLevel: '128-GCM',
    encryptedFiles: 0,
    desensitizeRate: 95,

    // 数据流计数
    rawCount: 0,

    // 生命周期统计
    hotCount: 0,
    warmCount: 0,
    coldCount: 0,
    destroyedCount: 0,

    // 审计日志
    auditLogs: [
      { time: '刚刚', message: '引擎数据已脱敏处理', type: 'info' },
      { time: '2分钟前', message: '热数据加密存储完成', type: 'success' },
      { time: '5分钟前', message: '检测到久坐体态，已记录', type: 'warning' },
      { time: '10分钟前', message: '系统启动，加载加密密钥', type: 'info' },
      { time: '15分钟前', message: '差分隐私噪声注入完成 (ε=0.1)', type: 'success' },
    ],

    // 模块实例
    lifecycleManager: null,
    secureStorage: null,
  },

  onReady() {
    console.log('[Privacy] onReady')
    this._initModules()
    this._listenEvents()
  },

  onDestroy() {},

  /**
   * 初始化模块
   * @private
   */
  async _initModules() {
    try {
      this.lifecycleManager = new LifecycleManager()
      this.secureStorage = new SecureStorage()
      await this.secureStorage.init({ deviceId: 'mock-device-001', userPin: '1234' })

      this._loadLifecycleStats()
      this._loadAuditLogs()
    } catch (error) {
      console.error('[Privacy] Init failed:', error)
    }
  },

  /**
   * 监听事件
   * @private
   */
  _listenEvents() {
    eventBus.on('posture:detected', () => { this.rawCount++ })
    eventBus.on('privacy:sensitive-data', () => { this._loadLifecycleStats() })
  },

  /**
   * 加载生命周期统计
   * @private
   */
  async _loadLifecycleStats() {
    try {
      const lifecycleStats = await this.lifecycleManager.getLifecycleStats()
      if (lifecycleStats) {
        this.hotCount = lifecycleStats.hot || 0
        this.warmCount = lifecycleStats.warm || 0
        this.coldCount = lifecycleStats.cold || 0
        this.destroyedCount = lifecycleStats.destroyed || 0
      }
    } catch (e) {
      console.log('[Privacy] Lifecycle stats not available')
    }

    try {
      const storageStats = await this.secureStorage.getStats()
      if (storageStats) {
        this.encryptedFiles = storageStats.totalFiles || 0
      }
    } catch (e) {
      console.log('[Privacy] Storage stats not available')
    }
  },

  /**
   * 加载审计日志
   * @private
   */
  async _loadAuditLogs() {
    // 从 AuditLogger 获取真实日志（此处用 Mock 数据）
    this.auditLogs = [
      { time: '刚刚', message: '引擎数据已脱敏处理', type: 'info' },
      { time: '2分钟前', message: '热数据加密存储完成', type: 'success' },
      { time: '5分钟前', message: '检测到久坐体态，已记录', type: 'warning' },
      { time: '10分钟前', message: '系统启动，加载加密密钥', type: 'info' },
      { time: '15分钟前', message: '差分隐私噪声注入完成 (ε=0.1)', type: 'success' },
    ]
  },

  /**
   * 显示加密信息
   */
  showEncryptInfo() {
    prompt.showToast({ message: `当前使用 AES-${this.encryptLevel} 加密` })
  },

  /**
   * 页面导航
   */
  goTo(page) {
    router.push({ uri: `/pages/${page}/${page}` })
  },

  goBack() {
    router.back()
  },
}
</script>

<style>
