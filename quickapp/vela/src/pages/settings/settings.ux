<template>
  <div class="page">
    <div class="header">
      <div class="back-btn" onclick="goBack">
        <text class="back-icon">←</text>
      </div>
      <text class="title">设置</text>
      <div class="header-right"></div>
    </div>

    <div class="scroll-content">
      <!-- 模型选择 -->
      <div class="section-card">
        <text class="section-title">🧠 AI 模型</text>
        <div class="option-group">
          <div class="option-item" onclick="switchModel('static_cnn')">
            <div class="radio {{ modelType === 'static_cnn' ? 'checked' : '' }}"></div>
            <div class="option-info">
              <text class="option-label">静态 CNN</text>
              <text class="option-desc">1D-CNN，适合静态体态分类</text>
            </div>
          </div>
          <div class="option-item" onclick="switchModel('dynamic_lstm')">
            <div class="radio {{ modelType === 'dynamic_lstm' ? 'checked' : '' }}"></div>
            <div class="option-info">
              <text class="option-label">动态 LSTM</text>
              <text class="option-desc">LSTM，适合动态动作识别（预留）</text>
            </div>
          </div>
        </div>
      </div>

      <!-- 采样率 -->
      <div class="section-card">
        <text class="section-title">📊 采样配置</text>
        <div class="option-group">
          <div class="setting-row">
            <text class="setting-label">传感器采样率</text>
            <text class="setting-value">{{ sampleRate }}Hz</text>
          </div>
          <div class="setting-row">
            <text class="setting-label">推理窗口</text>
            <text class="setting-value">100 帧 (2秒)</text>
          </div>
          <div class="setting-row">
            <text class="setting-label">滑动步长</text>
            <text class="setting-value">50 帧 (1秒)</text>
          </div>
        </div>
      </div>

      <!-- 功耗管理 -->
      <div class="section-card">
        <text class="section-title">🔋 功耗管理</text>
        <div class="option-group">
          <div class="setting-row">
            <text class="setting-label">自适应推理</text>
            <div class="toggle {{ adaptiveEnabled ? 'on' : '' }}" onclick="toggleAdaptive">
              <div class="toggle-thumb"></div>
            </div>
          </div>
          <div class="setting-row">
            <text class="setting-label">当前模式</text>
            <text class="setting-value">{{ powerModeDesc }}</text>
          </div>
        </div>
      </div>

      <!-- 关于 -->
      <div class="section-card">
        <text class="section-title">ℹ️ 关于</text>
        <div class="option-group">
          <div class="setting-row">
            <text class="setting-label">版本</text>
            <text class="setting-value">v2.0.0</text>
          </div>
          <div class="setting-row">
            <text class="setting-label">架构</text>
            <text class="setting-value">4层分离架构</text>
          </div>
          <div class="setting-row">
            <text class="setting-label">模型</text>
            <text class="setting-value">1D-CNN (量化 INT8)</text>
          </div>
        </div>
      </div>
    </div>

    <!-- 底部导航 -->
    <div class="bottom-nav">
      <div class="nav-item" onclick="goTo('index')">
        <text class="nav-icon">🏠</text>
        <text class="nav-label">首页</text>
      </div>
      <div class="nav-item" onclick="goTo('history')">
        <text class="nav-icon">📊</text>
        <text class="nav-label">历史</text>
      </div>
      <div class="nav-item active">
        <text class="nav-icon">⚙️</text>
        <text class="nav-label">设置</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import storage from '@system.storage'

const STORAGE_KEY = 'pose_settings'

export default {
  private: {
    modelType: 'static_cnn',
    sampleRate: 50,
    adaptiveEnabled: true,
    powerModeDesc: '正常模式 (50Hz, 1s)',
  },

  onReady() {
    this._loadSettings()
  },

  _loadSettings() {
    storage.get({
      key: STORAGE_KEY,
      success: (data) => {
        try {
          const s = JSON.parse(data)
          this.modelType = s.modelType || 'static_cnn'
          this.adaptiveEnabled = s.adaptiveEnabled !== false
        } catch (e) {}
      },
    })
  },

  _saveSettings() {
    storage.set({
      key: STORAGE_KEY,
      value: JSON.stringify({
        modelType: this.modelType,
        adaptiveEnabled: this.adaptiveEnabled,
      }),
      success: () => prompt.showToast({ message: '设置已保存' }),
    })
  },

  switchModel(type) {
    this.modelType = type
    this._saveSettings()
  },

  toggleAdaptive() {
    this.adaptiveEnabled = !this.adaptiveEnabled
    this._saveSettings()
  },

  goTo(page) {
    router.push({ uri: `/pages/${page}/${page}` })
  },

  goBack() {
    router.back()
  },
}
</script>

