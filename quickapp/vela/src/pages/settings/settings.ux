  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 12px;
  background-color: #1a1a2e;
}

.back-btn { width: 30px; height: 30px; justify-content: center; align-items: center; }
.back-icon { font-size: 20px; color: #ffffff; }
.title { font-size: 16px; color: #ffffff; font-weight: bold; }
.header-right { width: 30px; }

.scroll-content {
  flex: 1;
  flex-direction: column;
  padding: 8px 12px;
}

.section-card {
  margin-bottom: 8px;
  padding: 10px;
  background-color: #1a1a2e;
  border-radius: 10px;
}

.section-title {
  font-size: 13px;
  color: #ffffff;
  font-weight: bold;
  margin-bottom: 8px;
}

.option-group { flex-direction: column; }

.option-item {
  flex-direction: row;
  align-items: center;
  padding: 8px 0;
  border-bottom-width: 1px;
  border-bottom-color: #2a2a4e;
}

.option-item:last-child { border-bottom-width: 0; }

.radio {
  width: 16px;
  height: 16px;
  border-radius: 8px;
  border-width: 2px;
  border-color: #666666;
  margin-right: 10px;
}

.radio.checked {
  background-color: #2979FF;
  border-color: #2979FF;
}

.option-info { flex: 1; flex-direction: column; }
.option-label { font-size: 13px; color: #ffffff; }
.option-desc { font-size: 10px; color: #888888; margin-top: 2px; }

.setting-row {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 6px 0;
}

.setting-label { font-size: 12px; color: #ffffff; }
.setting-value { font-size: 12px; color: #666666; }

.toggle {
  width: 44px;
  height: 24px;
  border-radius: 12px;
  background-color: #333333;
  padding: 2px;
  justify-content: flex-start;
  align-items: center;
}

.toggle.on {
  background-color: #2979FF;
  justify-content: flex-end;
}

.toggle-thumb {
  width: 20px;
  height: 20px;
  border-radius: 10px;
  background-color: #ffffff;
}

.bottom-nav {
  flex-direction: row;
  justify-content: space-around;
  align-items: center;
  background-color: #1a1a2e;
  border-top-width: 1px;
  border-top-color: #2a2a4e;
  padding: 6px 0;
}

.nav-item { flex-direction: column; align-items: center; padding: 4px 10px; }
.nav-item.active .nav-label { color: #2979FF; }
.nav-icon { font-size: 18px; }
.nav-label { font-size: 9px; color: #888888; margin-top: 2px; }
</style>
