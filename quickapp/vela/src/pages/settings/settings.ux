<!--
  settings.ux - 设置页

  功能：
  - 调整传感器采样频率
  - 调整推理灵敏度（置信度阈值）
  - 显示模型信息和系统状态
  - 重置所有设置
-->
<template>
  <div class="page-container">
    <!-- 顶部导航 -->
    <div class="top-bar">
      <text class="back-btn" onclick="goBack">← 返回</text>
      <text class="page-title">⚙️ 设置</text>
    </div>

    <!-- 采样频率设置 -->
    <div class="setting-group">
      <text class="group-title">📡 传感器采样频率</text>
      <div class="option-row">
        <text class="option-btn {{sampleRate === 25 ? 'selected' : ''}}" onclick="setSampleRate(25)">25Hz</text>
        <text class="option-btn {{sampleRate === 50 ? 'selected' : ''}}" onclick="setSampleRate(50)">50Hz</text>
        <text class="option-btn {{sampleRate === 100 ? 'selected' : ''}}" onclick="setSampleRate(100)">100Hz</text>
      </div>
      <text class="setting-hint">频率越高越精准，但功耗越大</text>
    </div>

    <!-- 推理间隔设置 -->
    <div class="setting-group">
      <text class="group-title">🧠 推理间隔</text>
      <div class="option-row">
        <text class="option-btn {{inferenceInterval === 200 ? 'selected' : ''}}" onclick="setInferenceInterval(200)">200ms</text>
        <text class="option-btn {{inferenceInterval === 500 ? 'selected' : ''}}" onclick="setInferenceInterval(500)">500ms</text>
        <text class="option-btn {{inferenceInterval === 1000 ? 'selected' : ''}}" onclick="setInferenceInterval(1000)">1000ms</text>
      </div>
      <text class="setting-hint">间隔越短响应越快，但CPU占用越高</text>
    </div>

    <!-- 置信度阈值 -->
    <div class="setting-group">
      <text class="group-title">📊 置信度阈值</text>
      <div class="option-row">
        <text class="option-btn {{confidenceThreshold === 0.3 ? 'selected' : ''}}" onclick="setConfidence(0.3)">低(30%)</text>
        <text class="option-btn {{confidenceThreshold === 0.5 ? 'selected' : ''}}" onclick="setConfidence(0.5)">中(50%)</text>
        <text class="option-btn {{confidenceThreshold === 0.7 ? 'selected' : ''}}" onclick="setConfidence(0.7)">高(70%)</text>
      </div>
      <text class="setting-hint">低于阈值的结果显示为"未知"</text>
    </div>

    <!-- 模型信息 -->
    <div class="setting-group">
      <text class="group-title">🤖 模型信息</text>
      <div class="info-row">
        <text class="info-label">架构</text>
        <text class="info-value">1D-CNN (2层卷积+FC)</text>
      </div>
      <div class="info-row">
        <text class="info-label">参数量</text>
        <text class="info-value">~6,500</text>
      </div>
      <div class="info-row">
        <text class="info-label">输入</text>
        <text class="info-value">50帧 × 6轴</text>
      </div>
      <div class="info-row">
        <text class="info-label">输出</text>
        <text class="info-value">5类姿态</text>
      </div>
      <div class="info-row">
        <text class="info-label">模型大小</text>
        <text class="info-value">~26KB (float32)</text>
      </div>
    </div>

    <!-- 重置按钮 -->
    <div class="bottom-bar">
      <text class="reset-btn" onclick="resetSettings">🔄 恢复默认设置</text>
    </div>
  </div>
</template>

<script>
import router from '@system.router';
import storage from '@system.storage';

var constants = require('../../common/constants');

export default {
  private: {
    sampleRate: constants.DEFAULT_SAMPLE_RATE,
    inferenceInterval: constants.INFERENCE_INTERVAL_MS,
    confidenceThreshold: constants.CONFIDENCE_THRESHOLD
  },

  /**
   * 页面显示时加载设置
   */
  onShow() {
    this._loadSettings();
  },

  /**
   * 返回上一页
   */
  goBack() {
    router.back();
  },

  /**
   * 设置采样频率
   */
  setSampleRate(rate) {
    this.sampleRate = rate;
    this._saveSettings();
  },

  /**
   * 设置推理间隔
   */
  setInferenceInterval(interval) {
    this.inferenceInterval = interval;
    this._saveSettings();
  },

  /**
   * 设置置信度阈值
   */
  setConfidence(threshold) {
    this.confidenceThreshold = threshold;
    this._saveSettings();
  },

  /**
   * 恢复默认设置
   */
  resetSettings() {
    this.sampleRate = constants.DEFAULT_SAMPLE_RATE;
    this.inferenceInterval = constants.INFERENCE_INTERVAL_MS;
    this.confidenceThreshold = constants.CONFIDENCE_THRESHOLD;
    this._saveSettings();
  },

  /**
   * 保存设置到本地存储
   */
  _saveSettings() {
    var settings = {
      sampleRate: this.sampleRate,
      inferenceInterval: this.inferenceInterval,
      confidenceThreshold: this.confidenceThreshold
    };
    storage.set({
      key: constants.STORAGE_KEYS.SETTINGS,
      value: JSON.stringify(settings),
      success: function () {
        console.log('[Settings] 设置已保存');
      },
      fail: function (data, code) {
        console.error('[Settings] 保存失败: ' + code);
      }
    });
  },

  /**
   * 从本地存储加载设置
   */
  _loadSettings() {
    var self = this;
    storage.get({
      key: constants.STORAGE_KEYS.SETTINGS,
      success: function (data) {
        try {
          var settings = JSON.parse(data);
          if (settings) {
            self.sampleRate = settings.sampleRate || constants.DEFAULT_SAMPLE_RATE;
            self.inferenceInterval = settings.inferenceInterval || constants.INFERENCE_INTERVAL_MS;
            self.confidenceThreshold = settings.confidenceThreshold || constants.CONFIDENCE_THRESHOLD;
          }
        } catch (e) {
          console.log('[Settings] 解析设置失败，使用默认值');
        }
      },
      fail: function (data, code) {
        console.log('[Settings] 无保存的设置: ' + code);
      }
    });
  }
}
</script>

<style>
/* 页面容器 */
.page-container {
  flex-direction: column;
  background-color: #0d0d1a;
  padding: 10px;
  width: 100%;
  height: 100%;
}

/* 顶部导航 */
.top-bar {
  flex-direction: row;
  align-items: center;
  margin-bottom: 12px;
}

.back-btn {
  font-size: 14px;
  color: #4fc3f7;
  margin-right: 12px;
}

.page-title {
  font-size: 16px;
  color: #ffffff;
  font-weight: bold;
}

/* 设置组 */
.setting-group {
  flex-direction: column;
  background-color: #1a1a2e;
  border-radius: 10px;
  padding: 10px;
  margin-bottom: 8px;
}

.group-title {
  font-size: 13px;
  color: #e0e0e0;
  font-weight: bold;
  margin-bottom: 8px;
}

/* 选项行 */
.option-row {
  flex-direction: row;
  justify-content: space-around;
  margin-bottom: 6px;
}

.option-btn {
  font-size: 12px;
  color: #aaaaaa;
  padding: 5px 12px;
  border-radius: 14px;
  background-color: #2a2a3e;
}

.option-btn.selected {
  color: #ffffff;
  background-color: #3a3a6a;
  border-width: 1px;
  border-color: #4fc3f7;
}

/* 提示文字 */
.setting-hint {
  font-size: 10px;
  color: #555555;
  text-align: center;
}

/* 信息行 */
.info-row {
  flex-direction: row;
  justify-content: space-between;
  padding: 3px 0;
}

.info-label {
  font-size: 12px;
  color: #888888;
}

.info-value {
  font-size: 12px;
  color: #cccccc;
}

/* 底部栏 */
.bottom-bar {
  margin-top: 8px;
}

.reset-btn {
  text-align: center;
  font-size: 13px;
  color: #FF5252;
  padding: 8px;
  background-color: #1a1a2e;
  border-radius: 10px;
}
</style>
