<template>
  <div class="page">
    <!-- 顶部导航 -->
    <div class="header">
      <div class="back-btn" onclick="goBack">
        <text class="back-icon">←</text>
      </div>
      <text class="title">健康报表</text>
      <div class="time-range" onclick="toggleTimeRange">
        <text class="time-range-text">{{ timeRangeLabel }}</text>
      </div>
    </div>

    <!-- 每日概览卡片 -->
    <div class="overview-card">
      <div class="overview-header">
        <text class="overview-title">📊 每日概览</text>
        <text class="overview-date">{{ today }}</text>
      </div>
      <div class="overview-row">
        <div class="overview-item">
          <text class="overview-value">{{ totalPostures }}</text>
          <text class="overview-label">总记录数</text>
        </div>
        <div class="overview-divider"></div>
        <div class="overview-item">
          <text class="overview-value {{ normalRate >= 80 ? 'val-good' : normalRate >= 60 ? 'val-warn' : 'val-danger' }}">{{ normalRate }}%</text>
          <text class="overview-label">正常率</text>
        </div>
        <div class="overview-divider"></div>
        <div class="overview-item">
          <text class="overview-value val-warn">{{ anomalyCount }}</text>
          <text class="overview-label">异常次数</text>
        </div>
      </div>
    </div>

    <!-- 体态分布饼图 -->
    <div class="chart-card">
      <div class="card-header">
        <text class="card-title">体态分布</text>
      </div>
      <div class="chart-center">
        <pie-chart data="{{ postureDistribution }}" size="130"></pie-chart>
      </div>
    </div>

    <!-- 异常统计柱状图 -->
    <div class="chart-card">
      <div class="card-header">
        <text class="card-title">异常类型统计</text>
      </div>
      <bar-chart
        data="{{ anomalyBarData }}"
        labels="{{ anomalyBarLabels }}"
        width="400"
        height="100"
        barColor="#2979FF"
      ></bar-chart>
    </div>

    <!-- 7日评分趋势 -->
    <div class="chart-card">
      <div class="card-header">
        <text class="card-title">7日健康评分趋势</text>
      </div>
      <line-chart
        data="{{ trendData }}"
        labels="{{ trendLabels }}"
        width="400"
        height="100"
        lineColor="#00C853"
      ></line-chart>
    </div>

    <!-- 健康建议 -->
    <div class="advice-card">
      <div class="card-header">
        <text class="card-icon">💡</text>
        <text class="card-title">健康建议</text>
      </div>
      <div class="advice-list">
        <div class="advice-item" for="{{ healthAdvice }}">
          <div class="advice-icon-wrap">
            <text class="advice-icon">{{ $item.icon }}</text>
          </div>
          <div class="advice-content">
            <text class="advice-title">{{ $item.title }}</text>
            <text class="advice-desc">{{ $item.desc }}</text>
          </div>
        </div>
      </div>
    </div>

    <!-- 底部导航 -->
    <div class="bottom-nav">
      <div class="nav-item" onclick="goTo('index')">
        <text class="nav-icon">🏠</text>
        <text class="nav-label">首页</text>
      </div>
      <div class="nav-item" onclick="goTo('posture')">
        <text class="nav-icon">🏃</text>
        <text class="nav-label">体态</text>
      </div>
      <div class="nav-item" onclick="goTo('privacy')">
        <text class="nav-icon">🛡️</text>
        <text class="nav-label">隐私</text>
      </div>
      <div class="nav-item active">
        <text class="nav-icon">📊</text>
        <text class="nav-label">报表</text>
      </div>
      <div class="nav-item" onclick="goTo('settings')">
        <text class="nav-icon">⚙️</text>
        <text class="nav-label">设置</text>
      </div>
    </div>
  </div>
</template>

<script>
/**
 * 健康报表页
 *
 * 功能：
 * - 每日概览（总记录数、正常率、异常次数）
 * - 体态分布饼图
 * - 异常类型柱状图
 * - 7日评分趋势折线图
 * - 健康建议
 * - 底部导航
 */

import router from '@system.router'

export default {
  private: {
    // 时间范围
    timeRange: 'week',
    timeRangeLabel: '近7天',

    // 今日日期
    today: '2026-08-26',

    // 每日概览
    totalPostures: 1247,
    normalRate: 72,
    anomalyCount: 348,

    // 体态分布饼图
    postureDistribution: [
      { label: '正常', value: 72, color: '#00C853' },
      { label: '久坐', value: 15, color: '#2979FF' },
      { label: '低头', value: 10, color: '#FF9800' },
      { label: '跷腿', value: 3, color: '#9C27B0' },
    ],

    // 异常统计柱状图
    anomalyBarData: [180, 120, 48],
    anomalyBarLabels: ['久坐', '低头', '跷腿'],

    // 7日评分趋势
    trendData: [65, 72, 68, 75, 80, 78, 82],
    trendLabels: ['周一', '周二', '周三', '周四', '周五', '周六', '周日'],

    // 健康建议
    healthAdvice: [
      { icon: '🪑', title: '久坐提醒', desc: '今日久坐180次，建议每45分钟起身活动5分钟' },
      { icon: '📱', title: '低头注意', desc: '低头120次，建议将手机抬高至眼睛水平' },
      { icon: '🦵', title: '坐姿纠正', desc: '跷腿48次，建议保持双脚平放地面' },
    ],
  },

  onReady() {
    console.log('[Report] onReady')
    this._setToday()
  },

  /**
   * 设置今日日期
   * @private
   */
  _setToday() {
    const now = new Date()
    const y = now.getFullYear()
    const m = String(now.getMonth() + 1).padStart(2, '0')
    const d = String(now.getDate()).padStart(2, '0')
    this.today = `${y}-${m}-${d}`
  },

  /**
   * 切换时间范围
   */
  toggleTimeRange() {
    const ranges = ['today', 'week', 'month']
    const labels = { today: '今日', week: '近7天', month: '近30天' }
    const currentIndex = ranges.indexOf(this.timeRange)
    const nextIndex = (currentIndex + 1) % ranges.length
    this.timeRange = ranges[nextIndex]
    this.timeRangeLabel = labels[this.timeRange]
  },

  /**
   * 页面导航
   */
  goTo(page) {
    router.push({ uri: `/pages/${page}/${page}` })
  },

  goBack() {
    router.back()
  },
}
</script>

