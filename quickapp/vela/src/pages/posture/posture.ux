  margin-bottom: 8px;
}

.card-icon {
  font-size: 14px;
  margin-right: 6px;
}

.card-title {
  font-size: 13px;
  color: #ffffff;
  font-weight: bold;
}

.card-subtitle {
  font-size: 11px;
  color: #666666;
  margin-left: 6px;
}

/* 时间线 */
.timeline-card {
  margin: 0 12px 8px;
  padding: 10px;
  background-color: #1a1a2e;
  border-radius: 10px;
}

.timeline-scroll {
  flex-direction: column;
  max-height: 100px;
}

.timeline-item {
  flex-direction: row;
