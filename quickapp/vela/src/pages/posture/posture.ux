  width: 10px;
  height: 10px;
  border-radius: 5px;
}

.realtime-dot.running { background-color: #00C853; }
.realtime-dot.stopped { background-color: #FF1744; }

/* Mock 场景切换 */
.mock-section {
  margin: 0 12px 8px;
  padding: 8px 10px;
  background-color: #1a1a2e;
  border-radius: 8px;
}

