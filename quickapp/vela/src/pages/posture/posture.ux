<template>
  <div class="page">
    <!-- 顶部导航 -->
    <div class="header">
      <div class="back-btn" onclick="goBack">
        <text class="back-icon">←</text>
      </div>
      <text class="title">体态分析</text>
      <div class="time-range" onclick="toggleTimeRange">
        <text class="time-range-text">{{ timeRangeLabel }}</text>
      </div>
    </div>

    <!-- 实时体态状态 -->
    <div class="realtime-card">
      <div class="realtime-row">
        <text class="realtime-emoji">{{ currentPostureIcon }}</text>
        <div class="realtime-info">
          <text class="realtime-type">{{ currentPostureType }}</text>
          <text class="realtime-detail">置信度 {{ currentConfidence }}% · {{ currentDuration }}秒</text>
        </div>
        <div class="realtime-dot {{ engineRunning ? 'running' : 'stopped' }}"></div>
      </div>
    </div>

    <!-- Mock 场景切换 -->
    <div class="mock-section">
      <text class="section-label">模拟场景</text>
      <div class="mock-btns">
        <div class="mock-btn {{ currentScenario === 'normal' ? 'active' : '' }}"
             onclick="switchScenario('normal')">
          <text class="mock-btn-text">😊 正常</text>
        </div>
        <div class="mock-btn {{ currentScenario === 'sedentary' ? 'active' : '' }}"
             onclick="switchScenario('sedentary')">
          <text class="mock-btn-text">🪑 久坐</text>
        </div>
        <div class="mock-btn {{ currentScenario === 'headDown' ? 'active' : '' }}"
             onclick="switchScenario('headDown')">
          <text class="mock-btn-text">📱 低头</text>
        </div>
        <div class="mock-btn {{ currentScenario === 'crossLeg' ? 'active' : '' }}"
             onclick="switchScenario('crossLeg')">
          <text class="mock-btn-text">🦵 跷腿</text>
        </div>
      </div>
    </div>

    <!-- 7日趋势折线图 -->
    <div class="chart-card">
      <div class="card-header">
        <text class="card-title">健康评分趋势</text>
        <text class="card-subtitle">{{ timeRangeLabel }}</text>
      </div>
      <line-chart
        data="{{ trendData }}"
        labels="{{ trendLabels }}"
        width="420"
        height="120"
        lineColor="#00C853"
      ></line-chart>
    </div>

    <!-- 异常类型饼图 -->
    <div class="chart-row">
      <div class="chart-half">
        <text class="card-title">异常分布</text>
        <pie-chart data="{{ anomalyDistribution }}" size="110"></pie-chart>
      </div>
      <div class="chart-half">
        <text class="card-title">体态分布</text>
        <pie-chart data="{{ postureDistribution }}" size="110"></pie-chart>
      </div>
    </div>

    <!-- 今日时间线 -->
    <div class="timeline-card">
      <div class="card-header">
        <text class="card-title">今日体态时间线</text>
      </div>
      <div class="timeline-scroll">
        <div class="timeline-item" for="{{ timelineData }}">
          <div class="timeline-time">{{ $item.time }}</div>
          <div class="timeline-bar {{ $item.type }}" style="width: {{ $item.width }}px"></div>
          <div class="timeline-label">{{ $item.label }}</div>
        </div>
      </div>
    </div>

    <!-- 改善建议 -->
    <div class="advice-card">
      <div class="card-header">
        <text class="card-icon">💡</text>
        <text class="card-title">改善建议</text>
      </div>
      <div class="advice-list">
        <div class="advice-item" for="{{ adviceList }}">
          <text class="advice-bullet">•</text>
          <text class="advice-text">{{ $item }}</text>
        </div>
      </div>
    </div>

    <!-- 底部导航 -->
    <div class="bottom-nav">
      <div class="nav-item" onclick="goTo('index')">
        <text class="nav-icon">🏠</text>
        <text class="nav-label">首页</text>
      </div>
      <div class="nav-item active">
        <text class="nav-icon">🏃</text>
        <text class="nav-label">体态</text>
      </div>
      <div class="nav-item" onclick="goTo('privacy')">
        <text class="nav-icon">🛡️</text>
        <text class="nav-label">隐私</text>
      </div>
      <div class="nav-item" onclick="goTo('report')">
        <text class="nav-icon">📊</text>
        <text class="nav-label">报表</text>
      </div>
      <div class="nav-item" onclick="goTo('settings')">
        <text class="nav-icon">⚙️</text>
        <text class="nav-label">设置</text>
      </div>
    </div>
  </div>
</template>

<script>
/**
 * 体态分析页
 *
 * 功能：
 * - 实时体态状态展示
 * - Mock 场景快速切换
 * - 7日趋势折线图
 * - 异常类型饼图 + 体态分布饼图
 * - 今日时间线
 * - 改善建议
 * - 底部导航
 */

import router from '@system.router'
import { PostureEngine } from '../../core/posture-engine'
import { getPostureName, getPostureIcon, POSTURE_TYPE } from '../../common/constants/postures'
import { SensorMock } from '../../common/utils/sensor-mock'

export default {
  private: {
    // 时间范围
    timeRange: 'week',
    timeRangeLabel: '近7天',

    // 实时体态
    currentPostureIcon: '⏳',
    currentPostureType: '等待数据...',
    currentConfidence: 0,
    currentDuration: 0,
    engineRunning: false,

    // Mock 场景
    currentScenario: 'normal',

    // 趋势数据（从存储加载，此处用 Mock 数据）
    trendData: [65, 72, 68, 75, 80, 78, 82],
    trendLabels: ['周一', '周二', '周三', '周四', '周五', '周六', '周日'],

    // 异常分布
    anomalyDistribution: [
      { label: '久坐', value: 35, color: '#2979FF' },
      { label: '低头', value: 45, color: '#FF9800' },
      { label: '跷腿', value: 20, color: '#9C27B0' },
    ],

    // 体态分布
    postureDistribution: [
      { label: '正常', value: 60, color: '#00C853' },
      { label: '久坐', value: 20, color: '#2979FF' },
      { label: '低头', value: 15, color: '#FF9800' },
      { label: '跷腿', value: 5, color: '#9C27B0' },
    ],

    // 时间线数据
    timelineData: [
      { time: '09:00', type: 'normal', width: 120, label: '正常坐姿' },
      { time: '10:30', type: 'sedentary', width: 180, label: '久坐 1.5h' },
      { time: '12:00', type: 'normal', width: 60, label: '午休' },
      { time: '14:00', type: 'forward', width: 90, label: '低头工作' },
      { time: '15:30', type: 'normal', width: 45, label: '活动休息' },
      { time: '16:00', type: 'cross', width: 120, label: '跷二郎腿' },
    ],

    // 改善建议
    adviceList: [
      '今日低头次数较多，建议每小时活动颈部',
      '久坐时长超过2小时，建议定时站立休息',
      '跷腿习惯需注意，建议保持双脚平放',
    ],

    // 引擎实例
    engine: null,
    sensorMock: null,
  },

  onReady() {
    console.log('[Posture] onReady')
    this._initEngine()
  },

  onDestroy() {
    if (this.engine) this.engine.stop()
    if (this.sensorMock) this.sensorMock.stopStream()
  },

  /**
   * 初始化引擎和 Mock
   * @private
   */
  async _initEngine() {
    try {
      this.engine = new PostureEngine({ sampleRate: 50, windowSize: 250 })
      await this.engine.init()

      this.engine.onResult = (filterResult, features) => {
        this.currentPostureIcon = getPostureIcon(filterResult.posture)
        this.currentPostureType = getPostureName(filterResult.posture)
        this.currentConfidence = Math.round(filterResult.confidence * 100)
        this.currentDuration = Math.round(filterResult.duration)
      }

      this.sensorMock = new SensorMock()
      this.sensorMock.injectScenario('mixed-daily')
      this.sensorMock.startStream((data) => {
        if (this.engine && this.engine.sensorInterface) {
          this.engine.sensorInterface._emitData(data)
        }
      })

      this.engine.start({ mockMode: true })
      this.engineRunning = true
    } catch (error) {
      console.error('[Posture] Engine init failed:', error)
    }
  },

  /**
   * 切换 Mock 场景
   */
  switchScenario(scenario) {
    const scenarioMap = {
      'normal': 'mixed-daily',
      'sedentary': 'sedentary-2h',
      'headDown': 'office-work-1h',
      'crossLeg': 'cross-leg-30m',
    }
    const mappedScenario = scenarioMap[scenario] || scenario

    if (this.sensorMock) {
      this.sensorMock.stopStream()
      this.sensorMock.injectScenario(mappedScenario)
      this.sensorMock.startStream((data) => {
        if (this.engine && this.engine.sensorInterface) {
          this.engine.sensorInterface._emitData(data)
        }
      })
    }
    this.currentScenario = scenario
  },

  /**
   * 切换时间范围
   */
  toggleTimeRange() {
    const ranges = ['today', 'week', 'month']
    const labels = { today: '今日', week: '近7天', month: '近30天' }
    const currentIndex = ranges.indexOf(this.timeRange)
    const nextIndex = (currentIndex + 1) % ranges.length
    this.timeRange = ranges[nextIndex]
    this.timeRangeLabel = labels[this.timeRange]
  },

  /**
   * 页面导航
   */
  goTo(page) {
    router.push({ uri: `/pages/${page}/${page}` })
  },

  goBack() {
    router.back()
  },
}
</script>

<style>
