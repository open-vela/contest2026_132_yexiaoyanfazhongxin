<template>
  <div class="page">
    <div class="header">
      <div class="back-btn" onclick="goBack">
        <text class="back-icon">←</text>
      </div>
      <text class="title">历史记录</text>
    </div>

    <!-- 统计摘要 -->
    <div class="stats-card">
      <div class="stat-row">
        <text class="stat-icon">📊</text>
        <text class="stat-label">总记录</text>
        <text class="stat-value">{{ totalRecords }}</text>
      </div>
      <div class="stat-row">
        <text class="stat-icon">✅</text>
        <text class="stat-label">正常率</text>
        <text class="stat-value">{{ normalRate }}%</text>
      </div>
      <div class="stat-row">
        <text class="stat-icon">⚠️</text>
        <text class="stat-label">异常次数</text>
        <text class="stat-value">{{ anomalyCount }}</text>
      </div>
    </div>

    <!-- 体态分布（纯 div 条形图） -->
    <div class="chart-card">
      <text class="card-title">体态分布</text>
      <div class="bar-row" for="{{ distribution }}">
        <text class="bar-label">{{ $item.label }}</text>
        <div class="bar-track">
          <div class="bar-fill" style="width: {{ $item.percent }}px; background-color: {{ $item.color }}"></div>
        </div>
        <text class="bar-value">{{ $item.count }}</text>
      </div>
    </div>

    <!-- 7日趋势（纯 div 折线） -->
    <div class="chart-card">
      <text class="card-title">7日评分趋势</text>
      <div class="trend-row">
        <div class="trend-bar" for="{{ trendData }}">
          <div class="trend-col">
            <div class="trend-fill" style="height: {{ $item }}px"></div>
          </div>
          <text class="trend-label">{{ trendLabels[$idx] }}</text>
        </div>
      </div>
    </div>

    <!-- 底部导航 -->
    <div class="bottom-nav">
      <div class="nav-item" onclick="goTo('index')">
        <text class="nav-icon">🏠</text>
        <text class="nav-label">首页</text>
      </div>
      <div class="nav-item active">
        <text class="nav-icon">📊</text>
        <text class="nav-label">历史</text>
      </div>
      <div class="nav-item" onclick="goTo('settings')">
        <text class="nav-icon">⚙️</text>
        <text class="nav-label">设置</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import { DataStore } from '../../storage/data-store'
import { POSE_TYPE } from '../../ai/pose-model'

const POSE_LABELS = {
  [POSE_TYPE.STANDARD_SIT]: '标准坐姿',
  [POSE_TYPE.HUNCHED_SIT]: '驼背坐姿',
  [POSE_TYPE.STANDARD_STAND]: '标准站姿',
  [POSE_TYPE.WALKING]: '行走',
  [POSE_TYPE.RUNNING]: '跑步',
  [POSE_TYPE.STILL]: '静止',
  [POSE_TYPE.UNKNOWN]: '未知',
}

const POSE_COLORS = {
  [POSE_TYPE.STANDARD_SIT]: '#00C853',
  [POSE_TYPE.HUNCHED_SIT]: '#FF9800',
  [POSE_TYPE.STANDARD_STAND]: '#2979FF',
  [POSE_TYPE.WALKING]: '#9C27B0',
  [POSE_TYPE.RUNNING]: '#FF1744',
  [POSE_TYPE.STILL]: '#607D8B',
  [POSE_TYPE.UNKNOWN]: '#999999',
}

export default {
  private: {
    totalRecords: 0,
    normalRate: 0,
    anomalyCount: 0,
    distribution: [],
    trendData: [],
    trendLabels: [],
    _dataStore: null,
  },

  async onReady() {
    this._dataStore = new DataStore()
    await this._dataStore.init()
    this._loadData()
  },

  async _loadData() {
    const todayStats = await this._dataStore.getDailyStats()
    const dist = []
    let total = 0
    for (const [pose, count] of Object.entries(todayStats.distribution || {})) {
      dist.push({ label: POSE_LABELS[pose] || pose, count: count, color: POSE_COLORS[pose] || '#666', percent: 0 })
      total += count
    }

    // 计算百分比条宽度
    const maxCount = Math.max(...dist.map(d => d.count), 1)
    dist.forEach(d => { d.percent = Math.round((d.count / maxCount) * 150) })

    this.distribution = dist.length > 0 ? dist : [{ label: '暂无数据', count: 0, color: '#333', percent: 0 }]
    this.totalRecords = total

    const normalCount = (todayStats.distribution || {})[POSE_TYPE.STANDARD_SIT] || 0
    this.normalRate = total > 0 ? Math.round(normalCount / total * 100) : 0
    this.anomalyCount = total - normalCount

    // 7日趋势
    const weekly = await this._dataStore.getWeeklyStats(7)
    this.trendData = weekly.map(d => d.total > 0 ? Math.round(d.avgConfidence * 80) : 5)
    this.trendLabels = weekly.map(d => d.date.slice(5))
  },

  goTo(page) {
    router.push({ uri: `/pages/${page}/${page}` })
  },

  goBack() {
    router.back()
  },
}
</script>

