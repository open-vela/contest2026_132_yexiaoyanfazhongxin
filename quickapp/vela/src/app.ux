<script>
/**
 * app.ux - 应用入口
 *
 * 管理应用全局生命周期：
 * - onCreate: 应用创建时初始化全局资源
 * - onDestroy: 应用销毁时释放资源
 *
 * 注意：传感器的实际启停由各页面管理，
 * 此处只做全局初始化和清理。
 */
export default {
  onCreate() {
    console.log('[App] 姿态守护应用已创建');
    // 记录应用启动时间，用于功耗统计
    this._startTime = Date.now();
  },

  onDestroy() {
    console.log('[App] 姿态守护应用已销毁');
    // 输出本次运行时长
    var duration = Date.now() - this._startTime;
    console.log('[App] 本次运行时长: ' + (duration / 1000).toFixed(1) + '秒');
  }
}
</script>
