        <div class="transform-arrow">
          <text class="arrow-text">→</text>
          <text class="arrow-label">加密</text>
        </div>

        <!-- 加密数据 -->
        <div class="transform-step">
          <div class="step-icon encrypted">
            <text class="step-emoji">🔒</text>
          </div>
          <text class="step-label">加密存储</text>
