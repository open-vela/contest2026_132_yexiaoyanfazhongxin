<template>
  <div class="page">
    <!-- 顶部导航 -->
    <div class="header">
      <div class="back-btn" onclick="goBack">
        <text class="back-icon">←</text>
      </div>
      <text class="title">📊 测试报告</text>
      <div class="run-btn" onclick="runAllTests">
        <text class="run-btn-text">运行测试</text>
      </div>
    </div>

    <!-- 测试状态 -->
    <div class="status-card" if="{{isRunning}}">
      <text class="status-text">正在运行: {{ currentTest }}</text>
      <div class="progress-bar">
        <div class="progress-fill" style="width: {{ progress }}%"></div>
      </div>
      <text class="progress-text">{{ progress }}%</text>
    </div>

    <!-- 测试结果 -->
    <div class="results-scroll">
      <!-- 场景测试 -->
      <div class="result-card">
        <div class="card-header">
          <text class="card-title">🎯 场景测试</text>
          <div class="badge {{ scenarioReport?.passed ? 'pass' : 'fail' }}">
            <text class="badge-text">{{ scenarioReport?.passed ? '通过' : '失败' }}</text>
          </div>
        </div>
        <div class="result-stats" if="{{scenarioReport}}">
          <div class="stat-item">
            <text class="stat-value">{{ scenarioReport.summary.overallAccuracy }}%</text>
            <text class="stat-label">准确率</text>
          </div>
          <div class="stat-item">
            <text class="stat-value">{{ scenarioReport.summary.overallLatency }}ms</text>
            <text class="stat-label">延迟</text>
          </div>
          <div class="stat-item">
            <text class="stat-value">{{ scenarioReport.summary.passedScenarios }}/{{ scenarioReport.summary.totalScenarios }}</text>
            <text class="stat-label">通过</text>
          </div>
        </div>
        <text class="no-data" else>尚未运行测试</text>
      </div>

      <!-- 安全扫描 -->
      <div class="result-card">
        <div class="card-header">
          <text class="card-title">🔒 安全扫描</text>
          <div class="badge {{ securityReport?.passed ? 'pass' : 'fail' }}">
            <text class="badge-text">{{ securityReport?.passed ? '通过' : '失败' }}</text>
          </div>
        </div>
        <div class="result-stats" if="{{securityReport}}">
          <div class="stat-item">
            <text class="stat-value critical">{{ securityReport.summary.critical }}</text>
            <text class="stat-label">严重</text>
          </div>
          <div class="stat-item">
            <text class="stat-value high">{{ securityReport.summary.high }}</text>
            <text class="stat-label">高危</text>
          </div>
          <div class="stat-item">
            <text class="stat-value medium">{{ securityReport.summary.medium }}</text>
            <text class="stat-label">中危</text>
          </div>
        </div>
        <text class="no-data" else>尚未运行测试</text>
      </div>

      <!-- 性能分析 -->
      <div class="result-card">
        <div class="card-header">
          <text class="card-title">⚡ 性能分析</text>
          <div class="badge {{ powerReport?.power?.percentConsumed < 15 ? 'pass' : 'fail' }}">
            <text class="badge-text">{{ powerReport?.power?.percentConsumed < 15 ? '达标' : '超标' }}</text>
          </div>
        </div>
        <div class="result-stats" if="{{powerReport}}">
          <div class="stat-item">
            <text class="stat-value">{{ powerReport.power.percentConsumed }}%</text>
            <text class="stat-label">8h电量</text>
          </div>
          <div class="stat-item">
            <text class="stat-value">{{ powerReport.resources.avgMemoryMb }}MB</text>
            <text class="stat-label">内存</text>
          </div>
          <div class="stat-item">
            <text class="stat-value">{{ powerReport.resources.avgCpuPercent }}%</text>
            <text class="stat-label">CPU</text>
          </div>
        </div>
        <text class="no-data" else>尚未运行测试</text>
      </div>

      <!-- 测试详情 -->
      <div class="detail-card" if="{{detailText}}">
        <text class="detail-title">详细报告</text>
        <text class="detail-text">{{ detailText }}</text>
      </div>
    </div>
  </div>
</template>

<script>
/**
 * 测试报告页面
 *
 * 展示场景测试、安全扫描、性能分析结果
 *
 * @module pages/test-report
 */

import router from '@system.router'
import { ScenarioTester } from '../../test/scenario-tester'
import { SecurityAuditor } from '../../test/security-auditor'
import { PerformanceProfiler } from '../../test/performance-profiler'

export default {
  private: {
    isRunning: false,
    currentTest: '',
    progress: 0,

    scenarioReport: null,
    securityReport: null,
    powerReport: null,
    detailText: '',
  },

  onReady() {
    console.log('[TestReport] onReady')
  },

  /**
   * 运行所有测试
   */
  async runAllTests() {
    if (this.isRunning) return

    this.isRunning = true
    this.progress = 0
    this.detailText = ''

    try {
      // 1. 场景测试
      this.currentTest = '场景测试'
      this.progress = 10
      const scenarioTester = new ScenarioTester()
      await scenarioTester.init()
      this.scenarioReport = await scenarioTester.runAllTests((p) => {
        this.currentTest = `场景测试: ${p.scenario}`
        this.progress = 10 + Math.round((p.current / p.total) * 30)
      })

      // 2. 安全扫描
      this.currentTest = '安全扫描'
      this.progress = 45
      const securityAuditor = new SecurityAuditor()
      // 加载源代码进行扫描
      await this._loadSourceFiles(securityAuditor)
      this.securityReport = await securityAuditor.runFullScan()
      this.progress = 65

      // 3. 性能分析
      this.currentTest = '性能分析'
      this.progress = 70
      const profiler = new PerformanceProfiler()
      await profiler.init()
      // 模拟运行数据
      await this._simulatePerformanceData(profiler)
      this.powerReport = profiler.generateReport()
      profiler.stop()
      this.progress = 90

      // 生成详细报告
      this.detailText = this._generateFullReport()
      this.progress = 100

    } catch (error) {
      console.error('[TestReport] Test failed:', error)
      this.detailText = `测试失败: ${error.message}`
    } finally {
      this.isRunning = false
      this.currentTest = '测试完成'
    }
  },

  /**
   * 加载源代码文件
   * @private
   */
  async _loadSourceFiles(auditor) {
    // 模拟加载关键文件内容
    const files = {
      'key-derivation.js': 'const masterKey = deriveKey(deviceId, userPin)',
      'crypto-manager.js': 'await crypto.subtle.encrypt(...)',
      'secure-storage.js': 'await this._writeFile(path, content)',
    }

    for (const [name, content] of Object.entries(files)) {
      auditor.loadFile(`/privacy/${name}`, content)
    }
  },

  /**
   * 模拟性能数据
   * @private
   */
  async _simulatePerformanceData(profiler) {
    // 模拟8小时运行
    for (let i = 0; i < 100; i++) {
      profiler.recordSensorData()
      if (i % 10 === 0) {
        profiler.recordInference()
      }
      if (i % 20 === 0) {
        profiler.recordStorageWrite()
      }
      if (i % 30 === 0) {
        profiler.recordModeChange('balanced')
      }
    }
  },

  /**
   * 生成完整报告
   * @private
   */
  _generateFullReport() {
    let text = '=== M5 全链路测试报告 ===\n'
    text += `时间: ${new Date().toLocaleString()}\n\n`

    // 场景测试摘要
    if (this.scenarioReport) {
      text += `【场景测试】${this.scenarioReport.summary.passed ? '✅' : '❌'}\n`
      text += `  准确率: ${this.scenarioReport.summary.overallAccuracy}%\n`
    }

    // 安全扫描摘要
    if (this.securityReport) {
      text += `【安全扫描】${this.securityReport.passed ? '✅' : '❌'}\n`
      text += `  问题数: ${this.securityReport.summary.total}\n`
    }

    // 性能分析摘要
    if (this.powerReport) {
      text += `【性能分析】${this.powerReport.power.percentConsumed < 15 ? '✅' : '❌'}\n`
      text += `  8h电量: ${this.powerReport.power.percentConsumed}%\n`
    }

    return text
  },

  /**
   * 返回上一页
   */
  goBack() {
    router.back()
  },
}
</script>

<style>
.page {
  flex-direction: column;
  width: 480px;
  height: 480px;
  background-color: #0a0a0a;
}

/* 顶部导航 */
.header {
  width: 100%;
  height: 50px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 15px;
  background-color: #1a1a2e;
}

.back-btn {
  width: 30px;
  height: 30px;
  justify-content: center;
  align-items: center;
}

.back-icon {
  font-size: 20px;
  color: #ffffff;
}

.title {
  font-size: 18px;
  color: #ffffff;
  font-weight: bold;
}

.run-btn {
  padding: 6px 12px;
  background-color: #00C853;
  border-radius: 12px;
}

.run-btn-text {
  font-size: 12px;
  color: #ffffff;
}

/* 测试状态 */
.status-card {
  width: 420px;
  padding: 12px;
  background-color: #1a1a2e;
  border-radius: 10px;
  margin: 10px auto;
}

.status-text {
  font-size: 14px;
  color: #ffffff;
  margin-bottom: 8px;
}

.progress-bar {
  width: 100%;
  height: 8px;
  background-color: #2a2a4e;
  border-radius: 4px;
}

.progress-fill {
  height: 100%;
  background-color: #2979FF;
  border-radius: 4px;
}

.progress-text {
  font-size: 12px;
  color: #888888;
  text-align: right;
  margin-top: 4px;
}

/* 结果滚动区 */
.results-scroll {
  flex: 1;
  flex-direction: column;
  padding: 10px;
  overflow-y: auto;
}

/* 结果卡片 */
.result-card {
  width: 420px;
  padding: 12px;
  background-color: #1a1a2e;
  border-radius: 10px;
  margin-bottom: 10px;
}

.card-header {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.card-title {
  font-size: 15px;
  color: #ffffff;
  font-weight: bold;
}

.badge {
  padding: 4px 10px;
  border-radius: 10px;
}

.badge.pass {
  background-color: rgba(0, 200, 83, 0.2);
}

.badge.fail {
  background-color: rgba(255, 23, 68, 0.2);
}

.badge-text {
  font-size: 12px;
  color: #ffffff;
}

.result-stats {
  flex-direction: row;
  justify-content: space-around;
}

.stat-item {
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 20px;
  color: #00C853;
  font-weight: bold;
}

.stat-value.critical {
  color: #FF1744;
}

.stat-value.high {
  color: #FF9800;
}

.stat-value.medium {
  color: #FFD600;
}

.stat-label {
  font-size: 11px;
  color: #888888;
  margin-top: 4px;
}

.no-data {
  font-size: 13px;
  color: #666666;
  text-align: center;
}

/* 详情卡片 */
.detail-card {
  width: 420px;
  padding: 12px;
  background-color: #1a1a2e;
  border-radius: 10px;
  margin-bottom: 10px;
}

.detail-title {
  font-size: 14px;
  color: #ffffff;
  font-weight: bold;
  margin-bottom: 8px;
}

.detail-text {
  font-size: 12px;
  color: #aaaaaa;
  font-family: monospace;
  white-space: pre-wrap;
}
</style>
