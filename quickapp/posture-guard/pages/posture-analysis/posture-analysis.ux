.advice-card {
  width: 420px;
  padding: 12px;
  background-color: #1a1a2e;
  border-radius: 10px;
  margin: 8px auto;
}

.card-header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 10px;
}

.card-icon {
  font-size: 16px;
  margin-right: 6px;
}

.card-title {
  font-size: 14px;
  color: #ffffff;
  font-weight: bold;
}

.card-subtitle {
  font-size: 12px;
  color: #666666;
  margin-left: 8px;
}

/* 时间线 */
.timeline-scroll {
  flex-direction: column;
  max-height: 120px;
}

.timeline-item {
  flex-direction: row;
  align-items: center;
  margin-bottom: 6px;
}

.timeline-time {
  font-size: 11px;
  color: #666666;
  width: 45px;
}

.timeline-bar {
  height: 16px;
  border-radius: 4px;
  margin: 0 8px;
}

.timeline-bar.normal {
  background-color: #00C853;
}

.timeline-bar.sedentary {
  background-color: #2979FF;
}

.timeline-bar.forward {
  background-color: #FF9800;
}

.timeline-bar.cross {
  background-color: #9C27B0;
}

.timeline-label {
  font-size: 11px;
  color: #aaaaaa;
}

/* 改善建议 */
.advice-list {
  flex-direction: column;
}

.advice-item {
  flex-direction: row;
  margin-bottom: 8px;
}

.advice-bullet {
  font-size: 14px;
  color: #FFD600;
  width: 16px;
}

