  font-size: 11px;
  color: #666666;
}

/* ============ 方形表盘样式 ============ */
.page.square {
  flex-direction: column;
  padding: 15px;
}

/* 顶部评分区 */
.square-header {
  width: 100%;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 10px 0;
}

.score-section {
  flex-direction: column;
}

.score-value {
  font-size: 56px;
  font-weight: bold;
}

.score-good {
  color: #00C853;
}

.score-warn {
  color: #FFD600;
}

.score-danger {
  color: #FF1744;
}

.score-label {
  font-size: 14px;
  color: #888888;
  margin-top: -5px;
}

.privacy-badge {
  padding: 5px;
}

/* 图表区 */
.chart-section {
  width: 100%;
  margin-top: 10px;
}

.section-title {
  font-size: 14px;
  color: #888888;
  margin-bottom: 8px;
}

/* 状态卡片 */
.status-card {
  width: 100%;
  padding: 12px;
  background-color: #1a1a2e;
  border-radius: 10px;
  margin-top: 12px;
}

.status-row {
  flex-direction: row;
  align-items: center;
}

.status-icon {
  font-size: 24px;
  margin-right: 10px;
}

.status-info {
  flex-direction: column;
  flex: 1;
}

.status-title {
  font-size: 13px;
  color: #888888;
}

.status-value {
  font-size: 15px;
  color: #00C853;
  font-weight: bold;
}

.status-details {
  flex-direction: row;
  justify-content: space-around;
  margin-top: 10px;
  padding-top: 10px;
  border-top-width: 1px;
  border-top-color: #2a2a4e;
}

.detail-item {
  flex-direction: column;
  align-items: center;
}

.detail-label {
  font-size: 11px;
