}

/* 当前体态 */
.current-posture {
  width: 100%;
  flex-direction: row;
  align-items: center;
  padding: 12px;
  background-color: #1a1a2e;
  border-radius: 10px;
  margin-top: 10px;
}

.posture-icon-wrapper {
  width: 44px;
  height: 44px;
  background-color: #2a2a4e;
  border-radius: 22px;
  justify-content: center;
  align-items: center;
}

.posture-emoji {
  font-size: 24px;
}

.posture-info {
  flex: 1;
  flex-direction: column;
