}

.posture-type {
  font-size: 16px;
  color: #ffffff;
  font-weight: bold;
}

.posture-confidence {
  font-size: 12px;
  color: #888888;
  margin-top: 2px;
}

.posture-duration {
  flex-direction: column;
  align-items: center;
}

.duration-value {
  font-size: 20px;
