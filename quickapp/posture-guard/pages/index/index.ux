  background-color: #FFD600;
}

.status-text {
  font-size: 11px;
  color: #888888;
}

.status-details-mini {
  flex-direction: row;
  margin-left: auto;
}

.detail-mini {
  font-size: 10px;
  color: #666666;
  margin-left: 8px;
}

/* ============ 圆形表盘样式 ============ */
.page.round {
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 30px;
}

.round-content {
  width: 100%;
  height: 100%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.round-center {
  justify-content: center;
  align-items: center;
}

.round-bottom {
  position: absolute;
  bottom: 60px;
  left: 0;
  right: 0;
  align-items: center;
}

.privacy-indicator {
  flex-direction: row;
  align-items: center;
  padding: 8px 16px;
  background-color: rgba(26, 26, 46, 0.8);
  border-radius: 20px;
}

.privacy-text {
  font-size: 12px;
  color: #ffffff;
  margin-left: 8px;
}

.pull-hint {
  position: absolute;
  bottom: 20px;
  left: 0;
  right: 0;
  align-items: center;
}

