  color: #FFD600;
}

/* 选项按钮组 */
.setting-options {
  flex-direction: row;
}

.option-btn {
  width: 40px;
  height: 32px;
  background-color: #2a2a4e;
  border-radius: 6px;
  justify-content: center;
