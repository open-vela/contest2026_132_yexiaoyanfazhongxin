.settings-scroll {
  flex: 1;
  flex-direction: column;
  padding: 10px;
  overflow-y: auto;
}

/* 设置区块 */
.settings-section {
  background-color: #1a1a2e;
  border-radius: 10px;
  padding: 12px;
  margin-bottom: 10px;
}

.section-title {
  font-size: 13px;
  color: #666666;
  margin-bottom: 10px;
  text-transform: uppercase;
}

/* 设置项 */
.setting-item {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 10px 0;
  border-bottom-width: 1px;
  border-bottom-color: #2a2a4e;
}

