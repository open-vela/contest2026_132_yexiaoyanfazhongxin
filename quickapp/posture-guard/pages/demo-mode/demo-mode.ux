  width: 1px;
  height: 50px;
  background-color: #2a2a4e;
}

/* 数据选择 */
.data-buttons {
  flex-direction: row;
  justify-content: space-between;
}

.data-btn {
  width: 120px;
  height: 36px;
  background-color: #2a2a4e;
  border-radius: 8px;
  justify-content: center;
  align-items: center;
}

.data-btn.active {
  background-color: #2979FF;
}

