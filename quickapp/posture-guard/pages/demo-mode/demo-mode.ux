  background-color: #FFD600;
}

.ctrl-btn.reset {
  background-color: #2979FF;
}

.ctrl-btn-text {
  font-size: 14px;
  color: #ffffff;
  font-weight: bold;
}

/* 进度条 */
.progress-section {
  flex-direction: column;
}

.progress-label {
  font-size: 12px;
  color: #888888;
  margin-bottom: 6px;
}

.progress-bar {
  width: 100%;
  height: 6px;
  background-color: #2a2a4e;
  border-radius: 3px;
}

.progress-fill {
  height: 100%;
  background-color: #00C853;
  border-radius: 3px;
}

.time-label {
  font-size: 11px;
  color: #666666;
  text-align: right;
  margin-top: 4px;
}

/* 结果行 */
.result-row {
  flex-direction: row;
  align-items: center;
}

.result-icon {
  width: 50px;
  height: 50px;
  background-color: #2a2a4e;
  border-radius: 25px;
  justify-content: center;
  align-items: center;
}

.posture-emoji {
  font-size: 28px;
}

.result-info {
  flex: 1;
  flex-direction: column;
  margin-left: 12px;
}

.result-type {
  font-size: 18px;
  color: #ffffff;
  font-weight: bold;
}

.result-confidence {
  font-size: 12px;
  color: #888888;
  margin-top: 2px;
}

.result-duration {
  flex-direction: column;
  align-items: center;
}

.duration-value {
  font-size: 16px;
  color: #00C853;
  font-weight: bold;
}

/* 隐私转化 */
.transform-row {
  flex-direction: row;
  justify-content: space-around;
  align-items: center;
}

.transform-step {
  flex-direction: column;
  align-items: center;
  width: 100px;
}

.step-icon {
  font-size: 24px;
  margin-bottom: 4px;
}

.step-label {
  font-size: 11px;
  color: #888888;
}

.step-value {
  font-size: 12px;
  color: #ffffff;
  margin-top: 4px;
}

.transform-arrow {
  font-size: 18px;
  color: #2979FF;
}

/* 评分 */
.score-card {
  flex-direction: row;
  justify-content: space-around;
  align-items: center;
}

