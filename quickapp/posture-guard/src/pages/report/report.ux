<template>
  <div class="page" @swipe="back">
    <!-- 顶部导航 -->
    <div class="header">
      <text class="back-btn" onclick="back">‹</text>
      <text class="title">健康报表</text>
      <text class="date-text">{{ todayDate }}</text>
    </div>

    <!-- 今日体态评分趋势 -->
    <div class="chart-section">
      <text class="section-title">今日体态评分趋势</text>
      <div class="chart-wrap">
        <chart
          class="chart"
          type="line"
          options="{{ scoreChartOpts }}"
          datasets="{{ scoreChartData }}"
        ></chart>
      </div>
      <div class="chart-labels">
        <text class="label-item">6:00</text>
        <text class="label-item">12:00</text>
        <text class="label-item">18:00</text>
        <text class="label-item">24:00</text>
      </div>
    </div>

    <!-- 体态异常类型分布 -->
    <div class="chart-section">
      <text class="section-title">体态异常分布</text>
      <div class="chart-wrap">
        <chart
          class="chart"
          type="bar"
          options="{{ barChartOpts }}"
          datasets="{{ barChartData }}"
        ></chart>
      </div>
      <div class="bar-legend">
        <text class="legend-item" style="color: #ff6b6b;">🪑 久坐</text>
        <text class="legend-item" style="color: #ffd93d;">📱 低头</text>
        <text class="legend-item" style="color: #4ecdc4;">🦵 跷腿</text>
      </div>
    </div>

    <!-- 数据处理统计 -->
    <div class="stats-section">
      <text class="section-title">数据处理统计</text>

      <div class="stat-row">
        <div class="stat-item">
          <text class="stat-value">{{ totalSamples }}</text>
          <text class="stat-label">传感器采样</text>
        </div>
        <div class="stat-item">
          <text class="stat-value">{{ anonymizedCount }}</text>
          <text class="stat-label">脱敏处理</text>
        </div>
        <div class="stat-item">
          <text class="stat-value">{{ encryptedCount }}</text>
          <text class="stat-label">加密存储</text>
        </div>
      </div>
    </div>

    <!-- 安全摘要 -->
    <div class="summary-section">
      <div class="summary-card">
        <text class="summary-title">🛡️ 安全摘要</text>
        <div class="summary-item">
          <text class="summary-label">数据本地化率</text>
          <text class="summary-value highlight">100%</text>
        </div>
        <div class="summary-item">
          <text class="summary-label">网络请求数</text>
          <text class="summary-value">0</text>
        </div>
        <div class="summary-item">
          <text class="summary-label">加密覆盖率</text>
          <text class="summary-value highlight">100%</text>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
export default {
  private: {
    todayDate: '',
    // 评分趋势图
    scoreChartData: [
      {
        strokeColor: '#00d4aa',
        fillColor: 'rgba(0,212,170,0.2)',
        data: [100, 95, 92, 88, 85, 90, 95, 100, 98, 95, 92, 88],
        gradient: true,
      },
    ],
    scoreChartOpts: {
      xAxis: {
        min: 0,
        max: 11,
        display: false,
        axisTick: 12,
      },
      yAxis: {
        min: 0,
        max: 100,
        display: false,
        axisTick: 11,
      },
      series: {
        lineStyle: { width: '2px' },
      },
    },
    // 异常分布柱状图
    barChartData: [
      {
        fillColor: '#ff6b6b',
        data: [3, 1, 0, 2, 0, 0, 1, 0, 0, 0, 0, 0],
      },
      {
        fillColor: '#ffd93d',
        data: [0, 1, 2, 1, 3, 2, 1, 0, 0, 0, 0, 0],
      },
      {
        fillColor: '#4ecdc4',
        data: [0, 0, 1, 0, 1, 0, 0, 0, 0, 0, 0, 0],
      },
    ],
    barChartOpts: {
      xAxis: {
        min: 0,
        max: 11,
        display: false,
        axisTick: 12,
      },
      yAxis: {
        min: 0,
        max: 5,
        display: false,
        axisTick: 6,
      },
    },
    // 统计数据
    totalSamples: 0,
    anonymizedCount: 0,
    encryptedCount: 0,
  },

  onReady() {
    this._updateDate()
    this._loadStats()
  },

  _updateDate() {
    const now = new Date()
    const month = now.getMonth() + 1
    const day = now.getDate()
    this.todayDate = `${month}月${day}日`
  },

  _loadStats() {
    // 模拟统计数据（实际应从 DataManager 加载）
    this.totalSamples = 12580
    this.anonymizedCount = 12580
    this.encryptedCount = 8420

    // 生成模拟趋势数据
    this._generateMockData()
  },

  _generateMockData() {
    const now = new Date()
    const hour = now.getHours()

    // 生成今日评分趋势（模拟）
    const scoreData = []
    for (let i = 0; i < 12; i++) {
      const h = i * 2
      let score = 100
      if (h < 8) score = 95 + Math.random() * 5
      else if (h < 12) score = 85 + Math.random() * 10
      else if (h < 14) score = 80 + Math.random() * 10
      else if (h < 18) score = 85 + Math.random() * 10
      else score = 90 + Math.random() * 10

      scoreData.push(Math.round(score))
    }

    this.scoreChartData = [
      {
        ...this.scoreChartData[0],
        data: scoreData,
      },
    ]

    // 生成异常分布数据（模拟）
    this.barChartData = [
      {
        fillColor: '#ff6b6b',
        data: [1, 2, 0, 3, 1, 0, 2, 0, 0, 0, 0, 0],
      },
      {
        fillColor: '#ffd93d',
        data: [0, 1, 2, 1, 2, 3, 1, 0, 0, 0, 0, 0],
      },
      {
        fillColor: '#4ecdc4',
        data: [0, 0, 1, 0, 1, 0, 0, 0, 0, 0, 0, 0],
      },
    ]
  },

  back(event) {
    if (!event || event.direction === 'right') {
      import('@system.router').then((router) => {
        router.back()
      })
    }
  },
}
</script>

