}

/* 数据统计行 */
.stats-row {
  width: 420px;
  flex-direction: row;
  justify-content: space-around;
  align-items: center;
  padding: 15px 0;
  margin-top: 15px;
}

.stat-item {
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 28px;
  color: #ffffff;
  font-weight: bold;
}

.stat-label {
  font-size: 14px;
  color: #888888;
  margin-top: 4px;
}

.stat-divider {
  width: 1px;
  height: 40px;
  background-color: #333333;
}

/* 状态卡片 */
.status-card {
  width: 420px;
  padding: 15px 20px;
  background-color: #1a1a2e;
  border-radius: 12px;
  margin-top: 15px;
}

.status-title {
  font-size: 18px;
  color: #888888;
  margin-bottom: 10px;
}

.status-row {
  flex-direction: row;
  align-items: center;
}

.status-icon {
  font-size: 36px;
  margin-right: 15px;
}

.status-info {
  flex-direction: column;
}

.status-type {
  font-size: 22px;
  color: #ffffff;
  font-weight: bold;
}

.status-detail {
  font-size: 16px;
  color: #888888;
  margin-top: 4px;
}

/* 功能菜单 */
.menu-grid {
  width: 420px;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 20px;
}

.menu-item {
  width: 195px;
  height: 80px;
  background-color: #1a1a2e;
  border-radius: 12px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 10px;
}

.menu-icon {
  font-size: 28px;
}

.menu-text {
  font-size: 16px;
  color: #ffffff;
