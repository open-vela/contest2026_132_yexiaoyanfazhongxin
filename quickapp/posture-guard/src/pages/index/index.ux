<template>
  <div class="page">
    <!-- 顶部状态栏 -->
    <div class="header">
      <text class="title">🔒 体态安全卫士</text>
      <text class="time">{{ currentTime }}</text>
    </div>

    <!-- 体态健康评分卡片 -->
    <div class="score-card">
      <text class="score-label">体态健康评分</text>
      <div class="score-circle">
        <text class="score-value">{{ healthScore }}</text>
        <text class="score-unit">分</text>
      </div>
      <div class="score-bar">
        <div class="score-fill" style="width: {{ healthScore }}%;"></div>
      </div>
      <text class="score-desc">{{ scoreDesc }}</text>
    </div>

    <!-- 今日数据概览 -->
    <div class="stats-row">
      <div class="stat-item">
        <text class="stat-value">{{ todayAlerts }}</text>
        <text class="stat-label">体态异常</text>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item">
        <text class="stat-value">{{ sedentaryMin }}</text>
        <text class="stat-label">久坐(分)</text>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item">
        <text class="stat-value">{{ privacyStatus }}</text>
        <text class="stat-label">隐私防护</text>
      </div>
    </div>

    <!-- 当前体态状态 -->
    <div class="status-card">
      <text class="status-title">当前体态</text>
      <div class="status-row">
        <text class="status-icon">{{ postureIcon }}</text>
        <div class="status-info">
          <text class="status-type">{{ postureType }}</text>
          <text class="status-detail">{{ postureDetail }}</text>
        </div>
      </div>
    </div>

    <!-- 功能入口 -->
    <div class="menu-grid">
      <div class="menu-item" onclick="goToPosture">
        <text class="menu-icon">📊</text>
        <text class="menu-text">体态监测</text>
      </div>
      <div class="menu-item" onclick="goToPrivacy">
        <text class="menu-icon">🛡️</text>
        <text class="menu-text">安全详情</text>
      </div>
      <div class="menu-item" onclick="goToReport">
        <text class="menu-icon">📋</text>
        <text class="menu-text">健康报表</text>
      </div>
      <div class="menu-item" onclick="toggleMonitor">
        <text class="menu-icon">{{ monitorRunning ? '⏸️' : '▶️' }}</text>
        <text class="menu-text">{{ monitorRunning ? '暂停监测' : '开启监测' }}</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import sensor from '@system.sensor'
import health from '@service.health'
import vibrator from '@system.vibrator'
import prompt from '@system.prompt'
import PostureDetector, { POSTURE_TYPE, POSTURE_NAME } from '../../lib/posture-detector'
import Anonymizer from '../../lib/anonymizer'
import DataManager from '../../lib/data-manager'

export default {
  private: {
    currentTime: '--:--',
    healthScore: 100,
    scoreDesc: '体态良好',
    todayAlerts: 0,
    sedentaryMin: 0,
    privacyStatus: '✓',
    postureIcon: '😊',
    postureType: '正常',
    postureDetail: '体态良好，继续保持',
    monitorRunning: false,
    // 内部状态
    detector: null,
    anonymizer: null,
    dataManager: null,
    timeTimer: null,
    accelBuffer: [],
  },

  onReady() {
    console.log('[Index] onReady')
    this._initModules()
    this._startTimer()
    this._loadTodayData()
  },

  onDestroy() {
    console.log('[Index] onDestroy')
    this._stopMonitor()
    if (this.timeTimer) {
      clearInterval(this.timeTimer)
    }
  },

  // 初始化模块
  _initModules() {
    this.detector = new PostureDetector({
      sedentaryThreshold: 30 * 60 * 1000,
    })
    this.anonymizer = new Anonymizer()
    this.dataManager = new DataManager()

    // 设置检测回调
    this.detector.onDetect = (result) => {
      this._handlePostureResult(result)
    }
  },

  // 启动时间更新
  _startTimer() {
    this._updateTime()
    this.timeTimer = setInterval(() => {
      this._updateTime()
    }, 30000) // 每30秒更新
  },

  _updateTime() {
    const now = new Date()
    const h = String(now.getHours()).padStart(2, '0')
    const m = String(now.getMinutes()).padStart(2, '0')
    this.currentTime = `${h}:${m}`
  },

  // 加载今日数据
  _loadTodayData() {
    this.dataManager.loadTodayPostureStats((stats) => {
      if (stats) {
        this.todayAlerts = stats.totalAlerts || 0
        this.sedentaryMin = Math.round((stats.sedentaryMs || 0) / 60000)
        this._updateHealthScore()
      }
    })
  },

  // 处理体态检测结果
  _handlePostureResult(result) {
    this.postureIcon = this._getPostureIcon(result.type)
    this.postureType = PostureDetector.getPostureName(result.type)
    this.postureDetail = result.detail

    if (result.type !== POSTURE_TYPE.NORMAL) {
      this.todayAlerts++

      // 震动提醒
      vibrator.vibrate({ mode: 'long' })

      // 保存异常记录
      this.dataManager.savePostureAlert({
        type: result.type,
        confidence: result.confidence,
        detail: result.detail,
      })

      // Toast 提醒
      prompt.showToast({
        message: `⚠️ 检测到${PostureDetector.getPostureName(result.type)}`,
        duration: 1,
      })

      this._updateHealthScore()
    }

    // 更新久坐时间
    this.sedentaryMin = Math.round(this.detector.getTodaySedentaryMs() / 60000)
  },

  // 获取体态图标
  _getPostureIcon(type) {
    const icons = {
      [POSTURE_TYPE.NORMAL]: '😊',
      [POSTURE_TYPE.SEDENTARY]: '🪑',
      [POSTURE_TYPE.HEAD_TILT]: '📱',
      [POSTURE_TYPE.LEG_CROSS]: '🦵',
    }
    return icons[type] || '❓'
  },

  // 更新健康评分
  _updateHealthScore() {
    const alerts = this.todayAlerts
    let score = 100
    score -= Math.min(alerts * 5, 30) // 每次异常扣5分，最多30分
    score -= Math.min(this.sedentaryMin * 0.2, 20) // 久坐扣分
    this.healthScore = Math.max(0, Math.round(score))

    if (this.healthScore >= 80) {
      this.scoreDesc = '体态良好'
    } else if (this.healthScore >= 60) {
      this.scoreDesc = '需要注意'
    } else {
      this.scoreDesc = '体态警告'
    }
  },

  // 开始监测
  _startMonitor() {
    if (this.monitorRunning) return

    // 订阅加速度计
    sensor.subscribeAccelerometer({
      callback: (data) => {
        this._onAccelerometerData(data)
      },
      fail: (data, code) => {
        console.error('[Index] accelerometer fail:', code)
      },
    })

    // 订阅心率
    health.subscribeSample({
      dataType: health.DATA_TYPES.HEART_RATE,
      callback: (sample) => {
        this._onHeartRateData(sample)
      },
      fail: (data, code) => {
        console.error('[Index] health subscribe fail:', code)
      },
    })

    this.monitorRunning = true
    this.privacyStatus = '🟢'
    console.log('[Index] monitor started')
  },

  // 停止监测
  _stopMonitor() {
    if (!this.monitorRunning) return

    sensor.unsubscribeAccelerometer()
    health.unsubscribeSample({ dataType: health.DATA_TYPES.HEART_RATE })

    this.monitorRunning = false
    this.privacyStatus = '✓'
    console.log('[Index] monitor stopped')
  },

  // 加速度计数据回调
  _onAccelerometerData(data) {
    // 输入到体态检测器
    this.detector.input({ x: data.x, y: data.y, z: data.z })

    // 收集数据用于脱敏
    this.accelBuffer.push({ x: data.x, y: data.y, z: data.z })
    if (this.accelBuffer.length > 100) {
      // 脱敏处理
      const feature = this.anonymizer.anonymizeAcceleration(this.accelBuffer)
      if (feature) {
        this.dataManager.saveHRFeature(feature)
      }
      this.accelBuffer = []
    }
  },

  // 心率数据回调
  _onHeartRateData(sample) {
    // 脱敏处理
    const feature = this.anonymizer.anonymizeHeartRate(sample)
    if (feature) {
      this.dataManager.saveHRFeature(feature)
    }
  },

  // 页面导航
  goToPosture() {
    router.push({ uri: '/pages/posture' })
  },

  goToPrivacy() {
    router.push({ uri: '/pages/privacy' })
  },

  goToReport() {
    router.push({ uri: '/pages/report' })
  },

  // 切换监测状态
  toggleMonitor() {
    if (this.monitorRunning) {
      this._stopMonitor()
      prompt.showToast({ message: '监测已暂停' })
    } else {
      this._startMonitor()
      prompt.showToast({ message: '监测已开启' })
    }
  },
}
</script>

