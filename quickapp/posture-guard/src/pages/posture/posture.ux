.chart-section {
  width: 420px;
  padding: 15px;
  background-color: #1a1a2e;
  border-radius: 12px;
  margin-top: 10px;
}

.section-title {
  font-size: 18px;
  color: #888888;
  margin-bottom: 10px;
}

.chart-wrap {
  width: 390px;
  height: 120px;
}

.chart {
  width: 390px;
  height: 120px;
}

.axis-legend {
  flex-direction: row;
  justify-content: center;
  margin-top: 8px;
}

.legend-item {
  font-size: 14px;
  margin: 0 10px;
}

/* 状态区域 */
.status-section {
  width: 420px;
  margin-top: 12px;
}

.status-card {
  flex-direction: row;
  align-items: center;
  padding: 15px 20px;
  border-radius: 12px;
}

.status-normal {
  background-color: #1a2e1a;
  border: 1px solid #00d4aa;
}

.status-warning {
  background-color: #2e1a1a;
  border: 1px solid #ff6b6b;
}

.status-icon {
  font-size: 36px;
  margin-right: 15px;
}

.status-info {
  flex-direction: column;
}

.status-type {
  font-size: 22px;
  color: #ffffff;
  font-weight: bold;
}

.status-detail {
  font-size: 16px;
  color: #888888;
  margin-top: 4px;
}

/* 统计区域 */
.stats-section {
  width: 420px;
  flex-direction: row;
  justify-content: space-between;
  margin-top: 12px;
}

.stat-card {
  width: 130px;
  padding: 12px;
  background-color: #1a1a2e;
  border-radius: 10px;
  flex-direction: column;
  align-items: center;
}

.stat-label {
  font-size: 14px;
  color: #888888;
}

.stat-value {
  font-size: 28px;
  color: #ffffff;
  font-weight: bold;
  margin-top: 6px;
}

.stat-unit {
  font-size: 14px;
  color: #888888;
  font-weight: normal;
}

/* 控制按钮 */
.control-section {
  margin-top: 15px;
}

.btn {
  width: 200px;
  height: 50px;
  border-radius: 25px;
  justify-content: center;
  align-items: center;
}

.btn-start {
  background-color: #00d4aa;
}

.btn-stop {
  background-color: #ff6b6b;
}

.btn-text {
  font-size: 18px;
  color: #ffffff;
  font-weight: bold;
}
</style>
