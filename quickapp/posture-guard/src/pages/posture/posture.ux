<template>
  <div class="page" @swipe="back">
    <!-- 顶部导航 -->
    <div class="header">
      <text class="back-btn" onclick="back">‹</text>
      <text class="title">体态监测</text>
      <text class="status-dot {{ monitorActive ? 'active' : 'inactive' }}"></text>
    </div>

    <!-- 实时加速度波形图 -->
    <div class="chart-section">
      <text class="section-title">加速度波形</text>
      <div class="chart-wrap">
        <chart
          class="chart"
          type="line"
          options="{{ chartOpts }}"
          datasets="{{ chartData }}"
        ></chart>
      </div>
      <div class="axis-legend">
        <text class="legend-item" style="color: #ff6b6b;">● X轴</text>
        <text class="legend-item" style="color: #4ecdc4;">● Y轴</text>
        <text class="legend-item" style="color: #45b7d1;">● Z轴</text>
      </div>
    </div>

    <!-- 当前体态状态 -->
    <div class="status-section">
      <div class="status-card {{ statusClass }}">
        <text class="status-icon">{{ postureIcon }}</text>
        <div class="status-info">
          <text class="status-type">{{ postureType }}</text>
          <text class="status-detail">{{ postureDetail }}</text>
        </div>
      </div>
    </div>

    <!-- 今日统计 -->
    <div class="stats-section">
      <div class="stat-card">
        <text class="stat-label">久坐时长</text>
        <text class="stat-value">{{ sedentaryMin }}<text class="stat-unit">分钟</text></text>
      </div>
      <div class="stat-card">
        <text class="stat-label">异常次数</text>
        <text class="stat-value">{{ alertCount }}<text class="stat-unit">次</text></text>
      </div>
      <div class="stat-card">
        <text class="stat-label">活动次数</text>
        <text class="stat-value">{{ activityCount }}<text class="stat-unit">次</text></text>
      </div>
    </div>

    <!-- 控制按钮 -->
    <div class="control-section">
      <div class="btn {{ monitorActive ? 'btn-stop' : 'btn-start' }}" onclick="toggleMonitor">
        <text class="btn-text">{{ monitorActive ? '暂停监测' : '开始监测' }}</text>
      </div>
    </div>
  </div>
</template>

<script>
import sensor from '@system.sensor'
import vibrator from '@system.vibrator'
import prompt from '@system.prompt'
import PostureDetector, { POSTURE_TYPE, POSTURE_NAME } from '../../lib/posture-detector'

export default {
  private: {
    monitorActive: false,
    postureIcon: '😊',
    postureType: '正常',
    postureDetail: '等待监测数据...',
    statusClass: 'status-normal',
    sedentaryMin: 0,
    alertCount: 0,
    activityCount: 0,
    // 图表数据
    chartData: [
      { strokeColor: '#ff6b6b', data: [] },
      { strokeColor: '#4ecdc4', data: [] },
      { strokeColor: '#45b7d1', data: [] },
    ],
    chartOpts: {
      xAxis: { min: 0, max: 59, display: false, axisTick: 60 },
      yAxis: { min: -20, max: 20, display: false, axisTick: 21 },
      series: { lineStyle: { width: '1px' } },
    },
    // 内部状态
    detector: null,
    sampleIndex: 0,
    maxSamples: 60,
  },

  onReady() {
    this.detector = new PostureDetector({
      sedentaryThreshold: 30 * 60 * 1000,
    })

    this.detector.onDetect = (result) => {
      this._updateStatus(result)
    }
  },

  onDestroy() {
    this._stopMonitor()
  },

  // 返回上一页
  back(event) {
    if (!event || event.direction === 'right') {
      // 返回时停止监测
      this._stopMonitor()
      import('@system.router').then((router) => {
        router.back()
      })
    }
  },

  // 切换监测状态
  toggleMonitor() {
    if (this.monitorActive) {
      this._stopMonitor()
    } else {
      this._startMonitor()
    }
  },

  // 开始监测
  _startMonitor() {
    sensor.subscribeAccelerometer({
      callback: (data) => {
        this._onData(data)
      },
      fail: (data, code) => {
        console.error('[Posture] subscribe fail:', code)
        prompt.showToast({ message: '传感器订阅失败' })
      },
    })

    this.monitorActive = true
    prompt.showToast({ message: '监测已开启' })
  },

  // 停止监测
  _stopMonitor() {
    sensor.unsubscribeAccelerometer()
    this.monitorActive = false
  },

  // 数据回调
  _onData(data) {
    // 更新图表
    this._updateChart(data)

    // 输入到检测器
    const result = this.detector.input({ x: data.x, y: data.y, z: data.z })
    if (result) {
      this._updateStatus(result)
    }
  },

  // 更新图表数据
  _updateChart(data) {
    const idx = this.sampleIndex % this.maxSamples

    // 缩放数据到图表范围 (-20 to 20)
    const scaleX = Math.round(data.x * 10)
    const scaleY = Math.round(data.y * 10)
    const scaleZ = Math.round(data.z * 10)

    // 更新各轴数据
    this.chartData[0].data[idx] = scaleX
    this.chartData[1].data[idx] = scaleY
    this.chartData[2].data[idx] = scaleZ

    // 触发图表更新（创建新引用）
    this.chartData = [
      { ...this.chartData[0], data: [...this.chartData[0].data] },
      { ...this.chartData[1], data: [...this.chartData[1].data] },
      { ...this.chartData[2], data: [...this.chartData[2].data] },
    ]

    this.sampleIndex++
  },

  // 更新体态状态显示
  _updateStatus(result) {
    this.postureIcon = this._getIcon(result.type)
    this.postureType = PostureDetector.getPostureName(result.type)
    this.postureDetail = result.detail || '检测中...'

    if (result.type === POSTURE_TYPE.NORMAL) {
      this.statusClass = 'status-normal'
      this.activityCount++
    } else {
      this.statusClass = 'status-warning'
      this.alertCount++
      vibrator.vibrate({ mode: 'long' })
    }

    this.sedentaryMin = Math.round(this.detector.getTodaySedentaryMs() / 60000)
  },

  _getIcon(type) {
    const icons = {
      [POSTURE_TYPE.NORMAL]: '😊',
      [POSTURE_TYPE.SEDENTARY]: '🪑',
      [POSTURE_TYPE.HEAD_TILT]: '📱',
      [POSTURE_TYPE.LEG_CROSS]: '🦵',
    }
    return icons[type] || '❓'
  },
}
</script>

<style>
