<template>
  <div class="page" @swipe="back">
    <!-- 顶部导航 -->
    <div class="header">
      <text class="back-btn" onclick="back">‹</text>
      <text class="title">隐私防护</text>
      <text class="shield-icon">🛡️</text>
    </div>

    <!-- 整体防护状态 -->
    <div class="protect-status">
      <text class="protect-icon">✅</text>
      <text class="protect-title">隐私数据已加密保护</text>
      <text class="protect-desc">所有敏感数据均在本地加密存储</text>
    </div>

    <!-- 加密级别展示 -->
    <div class="level-section">
      <text class="section-title">数据加密分级</text>

      <div class="level-card">
        <div class="level-header">
          <text class="level-badge l1">L1</text>
          <div class="level-info">
            <text class="level-name">普通统计</text>
            <text class="level-desc">体态计数、每日汇总</text>
          </div>
          <text class="level-method">明文</text>
        </div>
      </div>

      <div class="level-card">
        <div class="level-header">
          <text class="level-badge l2">L2</text>
          <div class="level-info">
            <text class="level-name">敏感记录</text>
            <text class="level-desc">体态异常详情</text>
          </div>
          <text class="level-method">AES-ECB</text>
        </div>
      </div>

      <div class="level-card">
        <div class="level-header">
          <text class="level-badge l3">L3</text>
          <div class="level-info">
            <text class="level-name">隐私数据</text>
            <text class="level-desc">心率、压力原始值</text>
          </div>
          <text class="level-method">AES-CBC</text>
        </div>
      </div>
    </div>

    <!-- 数据处理对比 -->
    <div class="compare-section">
      <text class="section-title">脱敏处理效果</text>

      <div class="compare-row">
        <div class="compare-item">
          <text class="compare-label">处理前</text>
          <div class="compare-data raw-data">
            <text class="data-line">心率: 72 bpm</text>
            <text class="data-line">时间: 14:32:15</text>
            <text class="data-line">坐标: 39.9°N</text>
          </div>
        </div>

        <text class="compare-arrow">→</text>

        <div class="compare-item">
          <text class="compare-label">处理后</text>
          <div class="compare-data anon-data">
            <text class="data-line">区间: 正常</text>
            <text class="data-line">时段: 14:00</text>
            <text class="data-line">特征: 仅保留</text>
          </div>
        </div>
      </div>
    </div>

    <!-- 数据生命周期 -->
    <div class="lifecycle-section">
      <text class="section-title">数据生命周期</text>

      <div class="lifecycle-item">
        <text class="lc-type">普通统计</text>
        <div class="lc-bar">
          <div class="lc-fill" style="width: {{ lcStatPercent }}%;"></div>
        </div>
        <text class="lc-days">{{ lcStatDays }}天后过期</text>
      </div>

      <div class="lifecycle-item">
        <text class="lc-type">异常记录</text>
        <div class="lc-bar">
          <div class="lc-fill l2-fill" style="width: {{ lcAlertPercent }}%;"></div>
        </div>
        <text class="lc-days">{{ lcAlertDays }}天后过期</text>
      </div>

      <div class="lifecycle-item">
        <text class="lc-type">隐私数据</text>
        <div class="lc-bar">
          <div class="lc-fill l3-fill" style="width: {{ lcPrivacyPercent }}%;"></div>
        </div>
        <text class="lc-days">{{ lcPrivacyHours }}小时后过期</text>
      </div>
    </div>

    <!-- 操作按钮 -->
    <div class="action-section">
      <div class="btn btn-clear" onclick="clearPrivacyData">
        <text class="btn-text">🗑️ 一键清除隐私数据</text>
      </div>
    </div>
  </div>
</template>

<script>
import prompt from '@system.prompt'
import DataManager from '../../lib/data-manager'

export default {
  private: {
    lcStatPercent: 85,
    lcStatDays: 6,
    lcAlertPercent: 60,
    lcAlertDays: 18,
    lcPrivacyPercent: 30,
    lcPrivacyHours: 16,
    dataManager: null,
  },

  onReady() {
    this.dataManager = new DataManager()
    this._updateLifecycle()
  },

  _updateLifecycle() {
    // 模拟生命周期数据（实际应从存储中计算）
    const now = new Date()
    const hour = now.getHours()

    // 普通统计：7天过期
    this.lcStatDays = 6
    this.lcStatPercent = Math.round((6 / 7) * 100)

    // 异常记录：30天过期
    this.lcAlertDays = 18
    this.lcAlertPercent = Math.round((18 / 30) * 100)

    // 隐私数据：24小时过期
    this.lcPrivacyHours = 24 - hour
    this.lcPrivacyPercent = Math.round(((24 - hour) / 24) * 100)
  },

  back(event) {
    if (!event || event.direction === 'right') {
      import('@system.router').then((router) => {
        router.back()
      })
    }
  },

  clearPrivacyData() {
    prompt.showToast({ message: '正在清除隐私数据...' })

    this.dataManager.clearAllPrivacyData(() => {
      prompt.showToast({ message: '✅ 隐私数据已清除' })
      this._updateLifecycle()
    })
  },
}
</script>

