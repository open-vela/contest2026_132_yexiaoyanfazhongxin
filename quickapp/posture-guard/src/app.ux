<template>
  <div>
    <slot></slot>
  </div>
</template>

<script>
/**
 * 体态安全卫士 - 应用入口
 *
 * 全局生命周期管理：
 * - onCreate: 初始化全局数据、启动后台监测服务
 * - onDestroy: 清理资源、停止传感器订阅
 */
import sensor from '@system.sensor'
import health from '@service.health'
import storage from '@system.storage'

export default {
  // 全局数据
  globalData: {
    // 体态识别状态
    postureState: {
      current: 'normal',        // 当前体态: normal/sedentary/head_tilt/leg_cross
      confidence: 1.0,
      lastAlertTime: 0,
      dailyAlertCount: 0,
    },
    // 加密存储实例（延迟初始化）
    cryptoStore: null,
    // 数据管理器实例
    dataManager: null,
    // 后台监测是否已启动
    bgMonitorStarted: false,
  },

  onCreate() {
    console.log('[App] onCreate - 体态安全卫士启动')
    // 初始化全局状态
    this.globalData.postureState = {
      current: 'normal',
      confidence: 1.0,
      lastAlertTime: 0,
      dailyAlertCount: 0,
    }
    this.globalData.bgMonitorStarted = false
  },

  onDestroy() {
    console.log('[App] onDestroy - 清理资源')
    // 停止传感器订阅
    sensor.unsubscribeAccelerometer()
    health.unsubscribeSample({ dataType: health.DATA_TYPES.HEART_RATE })
    this.globalData.bgMonitorStarted = false
  },
}
</script>

<style>
/* 全局样式 */
div {
  flex-direction: column;
}
</style>
