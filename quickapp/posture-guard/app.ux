<template>
  <div>
    <slot></slot>
  </div>
</template>

<script>
/**
 * 体态安全卫士 - 应用入口
 *
 * 全局生命周期管理：
 * - onCreate: 初始化全局数据、配置采样策略
 * - onDestroy: 清理资源、停止传感器订阅
 *
 * @module app
 */

import { SAMPLING_STRATEGY, DEFAULT_STRATEGY } from './common/constants/sampling-config'
import { SensorMock } from './common/utils/sensor-mock'

export default {
  // 全局数据
  globalData: {
    // 当前采样策略
    samplingStrategy: DEFAULT_STRATEGY,
    // Mock模式开关
    mockMode: true, // 默认开启Mock模式用于测试
    // Mock场景管理器
    sensorMock: null,
    // 当前Mock场景
    currentMockScenario: null,
    // 体态识别状态
    postureState: {
      current: 'normal',
      confidence: 1.0,
      lastAlertTime: 0,
      dailyAlertCount: 0,
    },
    // 后台监测是否已启动
    bgMonitorStarted: false,
  },

  onCreate() {
    console.log('[App] onCreate - 体态安全卫士启动')

    // 初始化Mock场景管理器
    this.globalData.sensorMock = new SensorMock()

    // 初始化全局状态
    this.globalData.postureState = {
      current: 'normal',
      confidence: 1.0,
      lastAlertTime: 0,
      dailyAlertCount: 0,
    }
    this.globalData.bgMonitorStarted = false

    console.log('[App] Mock mode:', this.globalData.mockMode ? 'enabled' : 'disabled')
  },

  onDestroy() {
    console.log('[App] onDestroy - 清理资源')

    // 停止Mock数据流
    if (this.globalData.sensorMock) {
      this.globalData.sensorMock.stopStream()
    }

    this.globalData.bgMonitorStarted = false
  },
}
</script>

<style>
/* 全局样式 */
div {
  flex-direction: column;
}
</style>
