<template>
  <div class="ring-container">
    <canvas ref="ringCanvas" class="ring-canvas"></canvas>
    <div class="ring-center">
      <text class="ring-value">{{ value }}</text>
      <text class="ring-label">{{ label }}</text>
    </div>
  </div>
</template>

<script>
/**
 * 环形进度图组件
 *
 * 用于首页健康评分展示，支持：
 * - 中心数值显示
 * - 环形进度条（颜色根据分数变化）
 * - 外环异常分布弧段
 *
 * @module common/components/ring-chart
 */

export default {
  props: {
    value: { type: Number, default: 0 },
    label: { type: String, default: '健康评分' },
    segments: { type: Array, default: [] },
    size: { type: Number, default: 200 },
  },

  data() {
    return {
      ctx: null,
    }
  },

  onReady() {
    this._initCanvas()
    this._draw()
  },

  watch: {
    value() {
      this._draw()
    },
    segments() {
      this._draw()
    },
  },

  methods: {
    _initCanvas() {
      const canvas = this.$refs.ringCanvas
      if (canvas) {
        this.ctx = canvas.getContext('2d')
        canvas.width = this.size
        canvas.height = this.size
      }
    },

    _draw() {
      if (!this.ctx) return
      const ctx = this.ctx
      const center = this.size / 2
      const outerRadius = this.size / 2 - 10
      const innerRadius = outerRadius - 20

      ctx.clearRect(0, 0, this.size, this.size)

      // 绘制背景环
      ctx.beginPath()
      ctx.arc(center, center, outerRadius, 0, Math.PI * 2)
      ctx.arc(center, center, innerRadius, Math.PI * 2, 0, true)
      ctx.fillStyle = '#2a2a4e'
      ctx.fill()

      // 绘制外环异常分布
      if (this.segments && this.segments.length > 0) {
        this._drawSegments(ctx, center, outerRadius + 5, innerRadius - 5)
      }

      // 绘制进度环
      const score = Math.min(100, Math.max(0, this.value))
      const progress = score / 100
      const startAngle = -Math.PI / 2
      const endAngle = startAngle + (Math.PI * 2 * progress)

      // 渐变色
      let color
      if (score >= 80) {
        color = '#00C853'
      } else if (score >= 60) {
        color = '#FFD600'
      } else {
        color = '#FF1744'
      }

      ctx.beginPath()
      ctx.arc(center, center, outerRadius - 5, startAngle, endAngle)
      ctx.arc(center, center, innerRadius + 5, endAngle, startAngle, true)
      ctx.closePath()
      ctx.fillStyle = color
      ctx.fill()
    },

    _drawSegments(ctx, center, outerR, innerR) {
      const total = this.segments.reduce((sum, s) => sum + s.value, 0)
      if (total === 0) return

      let startAngle = -Math.PI / 2
      const gap = 0.02 // 弧段间距

      for (const seg of this.segments) {
        const sweep = (seg.value / total) * Math.PI * 2 - gap
        if (sweep <= 0) continue

        ctx.beginPath()
        ctx.arc(center, center, outerR, startAngle, startAngle + sweep)
        ctx.arc(center, center, innerR, startAngle + sweep, startAngle, true)
        ctx.closePath()
        ctx.fillStyle = seg.color
        ctx.fill()

        startAngle += sweep + gap
      }
    },
  },
}
</script>

<style>
.ring-container {
  width: 220px;
  height: 220px;
  justify-content: center;
  align-items: center;
}

.ring-canvas {
  width: 220px;
  height: 220px;
  position: absolute;
}

.ring-center {
  width: 120px;
  height: 120px;
  border-radius: 60px;
  background-color: #0a0a0a;
  justify-content: center;
  align-items: center;
  flex-direction: column;
}

.ring-value {
  font-size: 42px;
  color: #ffffff;
  font-weight: bold;
}

.ring-label {
  font-size: 14px;
  color: #888888;
  margin-top: 4px;
}
</style>
