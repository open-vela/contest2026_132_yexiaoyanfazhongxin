<template>
  <div class="page {{ isRoundScreen ? 'round-screen' : 'square-screen' }}" @swipe="handleSwipe">
    <!-- 顶部导航 -->
    <div class="header" style="padding-top: {{ safeAreaTop }}px;">
      <div class="back-btn" onclick="goBack">
        <text class="back-icon">‹</text>
      </div>
      <text class="title">设置</text>
      <div class="placeholder"></div>
    </div>

    <!-- 设置列表 -->
    <div class="settings-list">
      <!-- 检测间隔 -->
      <div class="setting-item">
        <div class="setting-info">
          <text class="setting-icon">⏱️</text>
          <div class="setting-text">
            <text class="setting-title">检测间隔</text>
            <text class="setting-desc">体态检测的时间间隔</text>
          </div>
        </div>
        <div class="setting-value" onclick="showIntervalPicker">
          <text class="value-text">{{ settings.postureCheckInterval }}分钟</text>
          <text class="arrow">›</text>
        </div>
      </div>

      <!-- 每日目标 -->
      <div class="setting-item">
        <div class="setting-info">
          <text class="setting-icon">🎯</text>
          <div class="setting-text">
            <text class="setting-title">每日目标</text>
            <text class="setting-desc">体态评分目标分数</text>
          </div>
        </div>
        <div class="setting-value" onclick="showGoalPicker">
          <text class="value-text">{{ settings.dailyPostureScore }}分</text>
          <text class="arrow">›</text>
        </div>
      </div>

      <!-- 提醒开关 -->
      <div class="setting-item">
        <div class="setting-info">
          <text class="setting-icon">🔔</text>
          <div class="setting-text">
            <text class="setting-title">震动提醒</text>
            <text class="setting-desc">不良体态时震动提醒</text>
          </div>
        </div>
        <div class="setting-toggle" onclick="toggleReminder">
          <div class="toggle-track {{ settings.reminderEnabled ? 'active' : '' }}">
            <div class="toggle-thumb"></div>
          </div>
        </div>
      </div>

      <!-- 震动强度 -->
      <div class="setting-item" if="{{ settings.reminderEnabled }}">
        <div class="setting-info">
          <text class="setting-icon">📳</text>
          <div class="setting-text">
            <text class="setting-title">震动强度</text>
            <text class="setting-desc">提醒震动的强度</text>
          </div>
        </div>
        <div class="setting-options">
          <div class="option {{ settings.vibrationIntensity === 'light' ? 'active' : '' }}" onclick="setVibration('light')">
            <text>轻</text>
          </div>
          <div class="option {{ settings.vibrationIntensity === 'medium' ? 'active' : '' }}" onclick="setVibration('medium')">
            <text>中</text>
          </div>
          <div class="option {{ settings.vibrationIntensity === 'strong' ? 'active' : '' }}" onclick="setVibration('strong')">
            <text>强</text>
          </div>
        </div>
      </div>

      <!-- AI分析开关 -->
      <div class="setting-item">
        <div class="setting-info">
          <text class="setting-icon">🤖</text>
          <div class="setting-text">
            <text class="setting-title">AI分析</text>
            <text class="setting-desc">启用AI智能分析和建议</text>
          </div>
        </div>
        <div class="setting-toggle" onclick="toggleAI">
          <div class="toggle-track {{ settings.aiEnabled ? 'active' : '' }}">
            <div class="toggle-thumb"></div>
          </div>
        </div>
      </div>

      <!-- 数据管理 -->
      <div class="setting-item">
        <div class="setting-info">
          <text class="setting-icon">💾</text>
          <div class="setting-text">
            <text class="setting-title">数据管理</text>
            <text class="setting-desc">导出或清除历史数据</text>
          </div>
        </div>
        <div class="setting-value" onclick="showDataManagement">
          <text class="arrow">›</text>
        </div>
      </div>

      <!-- 关于 -->
      <div class="setting-item">
        <div class="setting-info">
          <text class="setting-icon">ℹ️</text>
          <div class="setting-text">
            <text class="setting-title">关于</text>
            <text class="setting-desc">版本 1.0.0</text>
          </div>
        </div>
        <div class="setting-value" onclick="showAbout">
          <text class="arrow">›</text>
        </div>
      </div>
    </div>
  </div>
</template>

<style>
  /* 基础页面样式 */
  .page {
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
    display: flex;
    flex-direction: column;
    padding: 20px;
    box-sizing: border-box;
  }

  /* 方屏样式 */
  .square-screen {
    --safe-padding: 20px;
    --safe-area-top: 20px;
    --safe-area-bottom: 20px;
    --safe-area-left: 20px;
    --safe-area-right: 20px;
    --item-padding: 15px;
    --item-radius: 12px;
  }

  /* 圆屏样式 */
  .round-screen {
    --safe-padding: 40px;
    --safe-area-top: 45px;
    --safe-area-bottom: 45px;
    --safe-area-left: 40px;
    --safe-area-right: 40px;
    --item-padding: 12px;
    --item-radius: 16px;
  }

  /* 顶部导航 */
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    height: 40px;
    margin-bottom: 20px;
    padding-left: var(--safe-area-left);
    padding-right: var(--safe-area-right);
  }

  .back-btn {
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .back-icon {
    font-size: 28px;
    color: #ffffff;
  }

  .title {
    font-size: 20px;
    font-weight: bold;
    color: #ffffff;
  }

  .round-screen .title {
    font-size: 18px;
  }

  .placeholder {
    width: 30px;
  }

  /* 设置列表 */
  .settings-list {
    flex: 1;
    overflow-y: auto;
    padding-left: var(--safe-area-left);
    padding-right: var(--safe-area-right);
  }

  .setting-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--item-padding);
    background: rgba(255, 255, 255, 0.05);
    border-radius: var(--item-radius);
    margin-bottom: 10px;
  }

  .setting-info {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .setting-icon {
    font-size: 24px;
  }

  .setting-text {
    display: flex;
    flex-direction: column;
  }

  .setting-title {
    font-size: 16px;
    color: #ffffff;
    font-weight: 500;
  }

  .round-screen .setting-title {
    font-size: 14px;
  }

  .setting-desc {
    font-size: 12px;
    color: #a0a0a0;
    margin-top: 2px;
  }

  .round-screen .setting-desc {
    font-size: 11px;
  }

  .setting-value {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .value-text {
    font-size: 14px;
    color: #a78bfa;
  }

  .round-screen .value-text {
    font-size: 13px;
  }

  .arrow {
    font-size: 18px;
    color: #6b7280;
  }

  /* 开关 */
  .setting-toggle {
    padding: 5px;
  }

  .toggle-track {
    width: 44px;
    height: 24px;
    border-radius: 12px;
    background: #2d2d44;
    padding: 2px;
    transition: background 0.3s;
  }

  .toggle-track.active {
    background: #4ade80;
  }

  .toggle-thumb {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #ffffff;
    transition: transform 0.3s;
  }

  .toggle-track.active .toggle-thumb {
    transform: translateX(20px);
  }

  /* 选项 */
  .setting-options {
    display: flex;
    gap: 8px;
  }

  .option {
    padding: 6px 12px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.1);
  }

  .option.active {
    background: #4ade80;
  }

  .option text {
    font-size: 12px;
    color: #ffffff;
  }
</style>

<script>
  import router from '@system.router'
  import storage from '@system.storage'

  export default {
    private: {
      settings: {
        postureCheckInterval: 30,
        dailyPostureScore: 80,
        reminderEnabled: true,
        aiEnabled: true,
        vibrationIntensity: 'medium'
      },
      // 屏幕适配信息
      isRoundScreen: false,
      safeAreaTop: 20
    },

    onInit() {
      this.loadScreenInfo()
      this.loadSettings()
    },

    // 加载屏幕信息
    loadScreenInfo() {
      const app = this.$app
      if (app && app.globalData && app.globalData.screen) {
        const screen = app.globalData.screen
        this.isRoundScreen = screen.isRound
        this.safeAreaTop = screen.safeAreaTop
      }
    },

    // 加载设置
    loadSettings() {
      const app = this.$app
      if (app && app.globalData) {
        this.settings = { ...app.globalData.settings }
      }
    },

    // 保存设置
    saveSettings() {
      const app = this.$app
      if (app && app.saveSettings) {
        app.globalData.settings = { ...this.settings }
        app.saveSettings()
      }
    },

    // 显示间隔选择器
    showIntervalPicker() {
      // 简化实现：循环切换间隔
      const intervals = [15, 30, 45, 60]
      const currentIndex = intervals.indexOf(this.settings.postureCheckInterval)
      const nextIndex = (currentIndex + 1) % intervals.length
      this.settings.postureCheckInterval = intervals[nextIndex]
      this.saveSettings()
    },

    // 显示目标选择器
    showGoalPicker() {
      // 简化实现：循环切换目标
      const goals = [60, 70, 80, 90]
      const currentIndex = goals.indexOf(this.settings.dailyPostureScore)
      const nextIndex = (currentIndex + 1) % goals.length
      this.settings.dailyPostureScore = goals[nextIndex]
      this.saveSettings()
    },

    // 切换提醒
    toggleReminder() {
      this.settings.reminderEnabled = !this.settings.reminderEnabled
      this.saveSettings()
    },

    // 切换AI
    toggleAI() {
      this.settings.aiEnabled = !this.settings.aiEnabled
      this.saveSettings()
    },

    // 设置震动强度
    setVibration(intensity) {
      this.settings.vibrationIntensity = intensity
      this.saveSettings()
    },

    // 显示数据管理
    showDataManagement() {
      // 实际项目中会显示数据管理对话框
      console.log('显示数据管理')
    },

    // 显示关于
    showAbout() {
      // 实际项目中会显示关于页面
      console.log('显示关于')
    },

    // 返回
    goBack() {
      router.back()
    },

    // 手势处理
    handleSwipe(e) {
      if (e.direction === 'right') {
        router.back()
      }
    }
  }
</script>
