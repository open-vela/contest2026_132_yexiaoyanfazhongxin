<template>
  <div class="page {{ isRoundScreen ? 'round-screen' : 'square-screen' }}" @swipe="handleSwipe">
    <!-- 顶部状态栏 -->
    <div class="status-bar" style="padding-top: {{ safeAreaTop }}px;">
      <text class="time">{{ currentTime }}</text>
      <div class="status-icons">
        <text class="icon">⚡</text>
        <text class="battery">{{ battery }}%</text>
      </div>
    </div>

    <!-- 主要内容区域 -->
    <div class="main-content">
      <!-- 体态评分圆环 -->
      <div class="score-ring">
        <div class="ring-bg">
          <div class="ring-fill" style="transform: rotate({{ scoreRotation }}deg)"></div>
          <div class="score-center">
            <text class="score-number">{{ todayData.score }}</text>
            <text class="score-label">体态评分</text>
          </div>
        </div>
      </div>

      <!-- 状态指示 -->
      <div class="status-indicator">
        <div class="status-dot {{ isMonitoring ? 'active' : 'inactive' }}"></div>
        <text class="status-text">{{ isMonitoring ? '监测中' : '已暂停' }}</text>
      </div>

      <!-- 今日统计 -->
      <div class="stats-grid">
        <div class="stat-item">
          <text class="stat-icon">✅</text>
          <text class="stat-value">{{ todayData.goodPostureMinutes }}</text>
          <text class="stat-label">良好(分钟)</text>
        </div>
        <div class="stat-item">
          <text class="stat-icon">⚠️</text>
          <text class="stat-value">{{ todayData.badPostureMinutes }}</text>
          <text class="stat-label">不良(分钟)</text>
        </div>
        <div class="stat-item">
          <text class="stat-icon">🔔</text>
          <text class="stat-value">{{ todayData.reminders }}</text>
          <text class="stat-label">提醒次数</text>
        </div>
        <div class="stat-item">
          <text class="stat-icon">📊</text>
          <text class="stat-value">{{ todayData.totalChecks }}</text>
          <text class="stat-label">检测次数</text>
        </div>
      </div>

      <!-- AI 建议卡片 -->
      <div class="ai-card" onclick="showAIAdvice">
        <text class="ai-icon">🤖</text>
        <div class="ai-content">
          <text class="ai-title">AI 建议</text>
          <text class="ai-text">{{ aiAdvice }}</text>
        </div>
        <text class="ai-arrow">›</text>
      </div>
    </div>

    <!-- 底部导航栏 -->
    <div class="nav-bar" style="margin-bottom: {{ safeAreaBottom }}px;">
      <div class="nav-item active" onclick="goHome">
        <text class="nav-icon">🏠</text>
        <text class="nav-label">首页</text>
      </div>
      <div class="nav-item" onclick="goHistory">
        <text class="nav-icon">📊</text>
        <text class="nav-label">历史</text>
      </div>
      <div class="nav-item" onclick="goSettings">
        <text class="nav-icon">⚙️</text>
        <text class="nav-label">设置</text>
      </div>
    </div>
  </div>
</template>

<style>
  /* 基础页面样式 - 响应式 */
  .page {
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
    display: flex;
    flex-direction: column;
    padding: 20px;
    box-sizing: border-box;
  }

  /* 方屏样式 */
  .square-screen {
    --safe-padding: 20px;
    --safe-area-top: 20px;
    --safe-area-bottom: 20px;
    --safe-area-left: 20px;
    --safe-area-right: 20px;
    --score-ring-size: 180px;
    --score-center-size: 150px;
    --nav-height: 50px;
  }

  /* 圆屏样式 - 更大的安全边距 */
  .round-screen {
    --safe-padding: 40px;
    --safe-area-top: 45px;
    --safe-area-bottom: 45px;
    --safe-area-left: 40px;
    --safe-area-right: 40px;
    --score-ring-size: 160px;
    --score-center-size: 130px;
    --nav-height: 45px;
  }

  /* 状态栏 */
  .status-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    height: 30px;
    margin-bottom: 15px;
    padding-left: var(--safe-area-left);
    padding-right: var(--safe-area-right);
  }

  .time {
    font-size: 18px;
    color: #ffffff;
    font-weight: bold;
  }

  .status-icons {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .icon {
    font-size: 14px;
  }

  .battery {
    font-size: 14px;
    color: #a0a0a0;
  }

  /* 主要内容 */
  .main-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-around;
    padding-left: var(--safe-area-left);
    padding-right: var(--safe-area-right);
  }

  /* 评分圆环 */
  .score-ring {
    width: var(--score-ring-size);
    height: var(--score-ring-size);
    position: relative;
  }

  .ring-bg {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: #2d2d44;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ring-fill {
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 50%;
  }

  .score-center {
    width: var(--score-center-size);
    height: var(--score-center-size);
    border-radius: 50%;
    background: linear-gradient(135deg, #1a1a2e, #16213e);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .score-number {
    font-size: 48px;
    font-weight: bold;
    color: #4ade80;
  }

  .round-screen .score-number {
    font-size: 42px;
  }

  .score-label {
    font-size: 14px;
    color: #a0a0a0;
    margin-top: 5px;
  }

  /* 状态指示 */
  .status-indicator {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 10px 0;
  }

  .status-dot {
    width: 10px;
