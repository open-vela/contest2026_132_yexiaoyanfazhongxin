  .status-dot.active {
    background-color: #4ade80;
    box-shadow: 0 0 10px #4ade80;
    animation: pulse 2s infinite;
  }

  .status-dot.inactive {
    background-color: #6b7280;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  .status-text {
    font-size: 14px;
    color: #a0a0a0;
  }

  /* 统计网格 */
  .stats-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    width: 100%;
    gap: 10px;
    margin: 10px 0;
  }

  .stat-item {
    width: calc(50% - 5px);
    background: rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .round-screen .stat-item {
    border-radius: 16px;
    padding: 10px;
  }

  .stat-icon {
    font-size: 20px;
    margin-bottom: 5px;
  }

  .stat-value {
    font-size: 24px;
    font-weight: bold;
    color: #ffffff;
  }

  .round-screen .stat-value {
    font-size: 20px;
  }

  .stat-label {
    font-size: 11px;
    color: #a0a0a0;
    margin-top: 3px;
  }

  .round-screen .stat-label {
    font-size: 10px;
  }

  /* AI 卡片 */
  .ai-card {
    width: 100%;
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.2), rgba(168, 85, 247, 0.2));
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: 16px;
    padding: 15px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .round-screen .ai-card {
    border-radius: 20px;
    padding: 12px;
  }

  .ai-icon {
    font-size: 28px;
  }

  .ai-content {
    flex: 1;
  }

  .ai-title {
    font-size: 12px;
    color: #a78bfa;
    margin-bottom: 4px;
  }

  .ai-text {
    font-size: 14px;
    color: #e0e0e0;
    lines: 2;
    text-overflow: ellipsis;
  }

  .round-screen .ai-text {
    font-size: 13px;
  }

  .ai-arrow {
    font-size: 20px;
    color: #6b7280;
  }

  /* 底部导航 */
  .nav-bar {
    display: flex;
    justify-content: space-around;
    width: 100%;
    height: var(--nav-height);
    background: rgba(0, 0, 0, 0.3);
    border-radius: 25px;
    margin-top: 10px;
  }

  .nav-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex: 1;
  }

  .nav-item.active {
    background: rgba(99, 102, 241, 0.2);
    border-radius: 25px;
  }

  .nav-icon {
    font-size: 20px;
  }

  .nav-label {
    font-size: 10px;
    color: #a0a0a0;
    margin-top: 2px;
  }

  .nav-item.active .nav-label {
    color: #a78bfa;
  }

  /* 圆屏额外优化 */
  .round-screen .main-content {
    justify-content: center;
    gap: 15px;
  }

  .round-screen .stats-grid {
    gap: 8px;
    margin: 8px 0;
  }

  .round-screen .ai-card {
    margin-top: 5px;
  }
</style>

<script>
  import router from '@system.router'
  import vibrator from '@system.vibrator'
  import battery from '@system.battery'

  export default {
    private: {
      currentTime: '00:00',
      battery: 100,
      isMonitoring: true,
      todayData: {
        score: 85,
        goodPostureMinutes: 45,
        badPostureMinutes: 15,
        totalChecks: 12,
        reminders: 3,
        lastCheckTime: null
      },
      aiAdvice: '👍 今日体态良好，继续保持！',
      scorePercent: 85,
      scoreRotation: 0,
      checkTimer: null,
      // 屏幕适配信息
      isRoundScreen: false,
      safeAreaTop: 20,
      safeAreaBottom: 20
    },

    onInit() {
      this.loadScreenInfo()
      this.updateTime()
      this.loadTodayData()
      this.startMonitoring()
      this.loadBattery()
    },

    // 加载屏幕信息
    loadScreenInfo() {
      const app = this.$app
      if (app && app.globalData && app.globalData.screen) {
        const screen = app.globalData.screen
        this.isRoundScreen = screen.isRound
        this.safeAreaTop = screen.safeAreaTop
        this.safeAreaBottom = screen.safeAreaBottom
        console.log('屏幕类型:', this.isRoundScreen ? '圆屏' : '方屏')
      }
    },

    onDestroy() {
      this.stopMonitoring()
    },

    // 更新时间
    updateTime() {
      setInterval(() => {
        const now = new Date()
        this.currentTime = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`
      }, 1000)
    },

    // 加载电量
    loadBattery() {
      battery.getStatus({
        success: (data) => {
          this.battery = data.level
        }
      })
    },

    // 加载今日数据
    loadTodayData() {
      const app = this.$app
      if (app && app.globalData) {
        this.todayData = app.globalData.todayData
        this.updateScoreDisplay()
      }
    },

    // 更新分数显示
    updateScoreDisplay() {
      this.scorePercent = this.todayData.score
      this.scoreRotation = (this.todayData.score / 100) * 360

      // 更新AI建议
      if (this.todayData.score >= 90) {
        this.aiAdvice = '🎉 体态优秀！继续保持！'
      } else if (this.todayData.score >= 70) {
        this.aiAdvice = '👍 体态良好，还可以更好！'
      } else if (this.todayData.score >= 50) {
        this.aiAdvice = '⚠️ 体态一般，注意坐姿调整'
      } else {
        this.aiAdvice = '🚨 体态较差，请立即调整！'
      }
    },

    // 开始监测
    startMonitoring() {
      const app = this.$app
      const interval = (app && app.globalData && app.globalData.settings.postureCheckInterval) || 30

      // 模拟体态检测（实际项目中会调用传感器API）
      this.checkTimer = setInterval(() => {
        this.checkPosture()
      }, interval * 60 * 1000)

      this.isMonitoring = true
    },

    // 停止监测
    stopMonitoring() {
      if (this.checkTimer) {
        clearInterval(this.checkTimer)
        this.checkTimer = null
      }
      this.isMonitoring = false
    },

    // 检查体态
    checkPosture() {
      // 模拟体态检测结果（实际项目中会分析传感器数据）
      const isGoodPosture = Math.random() > 0.3 // 70%概率良好体态

      const app = this.$app
      if (app && app.updatePostureData) {
        app.updatePostureData(isGoodPosture)
        this.todayData = app.globalData.todayData
        this.updateScoreDisplay()
      }

      // 不良体态时震动提醒
      if (!isGoodPosture) {
        this.vibrateDevice()
      }
    },

    // 震动提醒
    vibrateDevice() {
      const app = this.$app
      const intensity = (app && app.globalData && app.globalData.settings.vibrationIntensity) || 'medium'

      let duration = 100
      if (intensity === 'strong') duration = 200
      else if (intensity === 'light') duration = 50

      vibrator.vibrate({ mode: 'short', duration: duration })
    },

    // 显示AI建议
    showAIAdvice() {
      router.push({
        uri: '/pages/alert',
        params: {
          type: 'ai_advice',
          score: this.todayData.score
        }
      })
    },

    // 手势处理
    handleSwipe(e) {
      if (e.direction === 'left') {
        router.push({ uri: '/pages/history' })
      } else if (e.direction === 'right') {
        router.push({ uri: '/pages/settings' })
      }
    },

    // 导航方法
    goHome() {
      // 已在首页
    },

    goHistory() {
      router.push({ uri: '/pages/history' })
    },

    goSettings() {
      router.push({ uri: '/pages/settings' })
    }
  }
</script>
