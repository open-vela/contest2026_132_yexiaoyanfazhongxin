<template>
  <div class="page {{ isRoundScreen ? 'round-screen' : 'square-screen' }}" @swipe="handleSwipe">
    <!-- 顶部导航 -->
    <div class="header" style="padding-top: {{ safeAreaTop }}px;">
      <div class="back-btn" onclick="goBack">
        <text class="back-icon">‹</text>
      </div>
      <text class="title">历史记录</text>
      <div class="period-selector">
        <div class="period {{ currentPeriod === 'week' ? 'active' : '' }}" onclick="setPeriod('week')">
          <text>周</text>
        </div>
        <div class="period {{ currentPeriod === 'month' ? 'active' : '' }}" onclick="setPeriod('month')">
          <text>月</text>
        </div>
      </div>
    </div>

    <!-- 本周概览 -->
    <div class="overview-card">
      <div class="overview-header">
        <text class="overview-title">本周概览</text>
        <text class="overview-period">{{ weekRange }}</text>
      </div>
      <div class="overview-stats">
        <div class="stat">
          <text class="stat-value">{{ weekAvgScore }}</text>
          <text class="stat-label">平均评分</text>
        </div>
        <div class="stat">
          <text class="stat-value">{{ weekTotalGood }}</text>
          <text class="stat-label">良好(分钟)</text>
        </div>
        <div class="stat">
          <text class="stat-value">{{ weekTotalBad }}</text>
          <text class="stat-label">不良(分钟)</text>
        </div>
      </div>
    </div>

    <!-- 图表区域 -->
    <div class="chart-container">
      <div class="chart-header">
        <text class="chart-title">每日评分趋势</text>
      </div>
      <div class="chart">
        <div class="chart-bars">
          <div class="bar-group" for="{{ weekData }}">
            <div class="bar" style="height: {{ $item.score * 1.2 }}px; background-color: {{ $item.score >= 80 ? '#4ade80' : $item.score >= 60 ? '#fbbf24' : '#ef4444' }}">
            </div>
            <text class="bar-label">{{ $item.day }}</text>
          </div>
        </div>
        <div class="chart-lines">
          <div class="line" style="top: 96px"></div>
          <div class="line" style="top: 72px"></div>
          <div class="line" style="top: 48px"></div>
          <div class="line-labels">
            <text>60</text>
            <text>80</text>
            <text>100</text>
          </div>
        </div>
      </div>
    </div>

    <!-- 每日详情列表 -->
    <div class="detail-list">
      <text class="list-title">每日详情</text>
      <div class="detail-item" for="{{ weekData }}">
        <div class="detail-info">
          <text class="detail-day">{{ $item.date }}</text>
          <text class="detail-score {{ $item.score >= 80 ? 'good' : $item.score >= 60 ? 'medium' : 'bad' }}">
            {{ $item.score }}分
          </text>
        </div>
        <div class="detail-bar">
          <div class="bar-fill" style="width: {{ $item.score }}%; background-color: {{ $item.score >= 80 ? '#4ade80' : $item.score >= 60 ? '#fbbf24' : '#ef4444' }}"></div>
        </div>
      </div>
    </div>

    <!-- AI分析按钮 -->
    <div class="ai-analysis-btn" onclick="getAIAnalysis">
      <text class="ai-icon">🤖</text>
      <text class="ai-text">获取AI周报分析</text>
    </div>
  </div>
</template>

