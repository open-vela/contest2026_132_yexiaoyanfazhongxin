  .ai-text {
    font-size: 14px;
    color: #ffffff;
  }
</style>

<script>
  import router from '@system.router'
  import storage from '@system.storage'

  export default {
    private: {
      currentPeriod: 'week',
      weekRange: '8月26日 - 9月1日',
      weekAvgScore: 78,
      weekTotalGood: 320,
      weekTotalBad: 80,
      weekData: [
        { day: '一', date: '8月26日', score: 82, good: 50, bad: 10 },
        { day: '二', date: '8月27日', score: 75, good: 45, bad: 15 },
        { day: '三', date: '8月28日', score: 80, good: 48, bad: 12 },
        { day: '四', date: '8月29日', score: 70, good: 42, bad: 18 },
        { day: '五', date: '8月30日', score: 85, good: 51, bad: 9 },
        { day: '六', date: '8月31日', score: 78, good: 47, bad: 13 },
        { day: '日', date: '9月1日', score: 85, good: 45, bad: 3 }
      ],
      // 屏幕适配信息
      isRoundScreen: false,
      safeAreaTop: 20
    },

    onInit() {
      this.loadScreenInfo()
      this.loadWeekData()
    },

    // 加载屏幕信息
    loadScreenInfo() {
      const app = this.$app
      if (app && app.globalData && app.globalData.screen) {
        const screen = app.globalData.screen
        this.isRoundScreen = screen.isRound
        this.safeAreaTop = screen.safeAreaTop
      }
    },

    // 加载周数据
    loadWeekData() {
      const app = this.$app
      if (app && app.globalData && app.globalData.weekData.length > 0) {
        this.weekData = app.globalData.weekData
        this.calculateOverview()
      }
    },

    // 计算概览数据
    calculateOverview() {
      if (this.weekData.length === 0) return

      let totalScore = 0
      let totalGood = 0
      let totalBad = 0

      this.weekData.forEach(day => {
        totalScore += day.score
        totalGood += day.good
        totalBad += day.bad
      })

      this.weekAvgScore = Math.round(totalScore / this.weekData.length)
      this.weekTotalGood = totalGood
      this.weekTotalBad = totalBad
    },

    // 切换周期
    setPeriod(period) {
      this.currentPeriod = period
      // 实际项目中会加载对应周期的数据
    },

    // 获取AI分析
    getAIAnalysis() {
      const app = this.$app
      if (app && app.getAIAnalysis) {
        const question = `分析我最近一周的体态数据：
平均评分：${this.weekAvgScore}
良好时间：${this.weekTotalGood}分钟
不良时间：${this.weekTotalBad}分钟
请给出改善建议。`

        app.getAIAnalysis(question).then(advice => {
          // 实际项目中会显示AI分析结果
          console.log('AI分析:', advice)
        })
      }
    },

    // 返回
    goBack() {
      router.back()
    },

    // 手势处理
    handleSwipe(e) {
      if (e.direction === 'right') {
        router.back()
      }
    }
  }
</script>
