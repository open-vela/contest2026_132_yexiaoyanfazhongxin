<template>
  <div class="page {{ isRoundScreen ? 'round-screen' : 'square-screen' }}" @swipe="handleSwipe">
    <!-- 顶部导航 -->
    <div class="header" style="padding-top: {{ safeAreaTop }}px;">
      <div class="back-btn" onclick="goBack">
        <text class="back-icon">‹</text>
      </div>
      <text class="title">{{ alertTitle }}</text>
      <div class="placeholder"></div>
    </div>

    <!-- 告警内容 -->
    <div class="alert-content">
      <!-- 图标 -->
      <div class="alert-icon-container">
        <text class="alert-icon">{{ alertIcon }}</text>
      </div>

      <!-- 标题 -->
      <text class="alert-main-title">{{ alertMainTitle }}</text>

      <!-- 描述 -->
      <text class="alert-description">{{ alertDescription }}</text>

      <!-- 详细信息 -->
      <div class="alert-details" if="{{ showDetails }}">
        <div class="detail-row" for="{{ details }}">
          <text class="detail-label">{{ $item.label }}</text>
          <text class="detail-value">{{ $item.value }}</text>
        </div>
      </div>

      <!-- AI建议 -->
      <div class="ai-advice-card" if="{{ aiAdvice }}">
        <div class="ai-header">
          <text class="ai-icon">🤖</text>
          <text class="ai-title">AI 建议</text>
        </div>
        <text class="ai-text">{{ aiAdvice }}</text>
      </div>

      <!-- 操作按钮 -->
      <div class="action-buttons">
        <div class="btn primary" onclick="handlePrimaryAction">
          <text class="btn-text">{{ primaryButtonText }}</text>
        </div>
        <div class="btn secondary" onclick="handleSecondaryAction">
          <text class="btn-text">{{ secondaryButtonText }}</text>
        </div>
      </div>
    </div>
  </div>
</template>

<style>
  /* 基础页面样式 */
  .page {
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
    display: flex;
    flex-direction: column;
    padding: 20px;
    box-sizing: border-box;
  }

  /* 方屏样式 */
  .square-screen {
    --safe-padding: 20px;
    --safe-area-top: 20px;
    --safe-area-bottom: 20px;
    --safe-area-left: 20px;
    --safe-area-right: 20px;
    --icon-size: 80px;
    --card-padding: 15px;
    --card-radius: 12px;
  }

  /* 圆屏样式 */
  .round-screen {
    --safe-padding: 40px;
    --safe-area-top: 45px;
    --safe-area-bottom: 45px;
    --safe-area-left: 40px;
    --safe-area-right: 40px;
    --icon-size: 70px;
    --card-padding: 12px;
    --card-radius: 16px;
  }

  /* 顶部导航 */
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    height: 40px;
    margin-bottom: 20px;
    padding-left: var(--safe-area-left);
    padding-right: var(--safe-area-right);
  }

  .back-btn {
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .back-icon {
    font-size: 28px;
    color: #ffffff;
  }

  .title {
    font-size: 20px;
    font-weight: bold;
    color: #ffffff;
  }

  .round-screen .title {
    font-size: 18px;
  }

  .placeholder {
    width: 30px;
  }

  /* 告警内容 */
  .alert-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-left: var(--safe-area-left);
    padding-right: var(--safe-area-right);
    padding-bottom: var(--safe-area-bottom);
  }

  /* 图标 */
  .alert-icon-container {
    width: var(--icon-size);
    height: var(--icon-size);
    border-radius: 50%;
    background: #1a1a2e;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
  }

  .alert-icon {
    font-size: 40px;
  }

  .round-screen .alert-icon {
    font-size: 35px;
  }

  /* 标题 */
  .alert-main-title {
    font-size: 24px;
    font-weight: bold;
    color: #ffffff;
    text-align: center;
    margin-bottom: 10px;
  }

  .round-screen .alert-main-title {
    font-size: 20px;
  }

  /* 描述 */
  .alert-description {
    font-size: 14px;
    color: #a0a0a0;
    text-align: center;
    lines: 3;
    margin-bottom: 20px;
    padding: 0 20px;
  }

  .round-screen .alert-description {
    font-size: 13px;
  }

  /* 详细信息 */
  .alert-details {
    width: 100%;
    background: #0d0d1a;
    border-radius: var(--card-radius);
    padding: var(--card-padding);
    margin-bottom: 20px;
  }

  .detail-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 0;
    border-bottom: 1px solid #0d0d1a;
  }

  .detail-label {
    font-size: 14px;
    color: #a0a0a0;
  }

  .detail-value {
    font-size: 14px;
    color: #ffffff;
    font-weight: 500;
  }

  /* AI建议卡片 */
  .ai-advice-card {
    width: 100%;
    background: linear-gradient(135deg, #1e1b4b, #2d1b69);
    border: 1px solid #4f46e5;
    border-radius: var(--card-radius);
    padding: var(--card-padding);
    margin-bottom: 20px;
  }

  .ai-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }

  .ai-icon {
    font-size: 24px;
  }

  .ai-title {
    font-size: 14px;
    color: #a78bfa;
    font-weight: 500;
  }

  .ai-text {
    font-size: 14px;
    color: #e0e0e0;
    lines: 4;
  }

  .round-screen .ai-text {
    font-size: 13px;
    lines: 3;
  }

  /* 操作按钮 */
  .action-buttons {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .btn {
    width: 100%;
    height: 45px;
    border-radius: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .btn.primary {
    background: linear-gradient(135deg, #4ade80, #22c55e);
  }

  .btn.secondary {
    background: #1a1a2e;
  }

  .btn-text {
    font-size: 16px;
    font-weight: bold;
    color: #ffffff;
  }
</style>

<script>
  import router from '@system.router'
  import vibrator from '@system.vibrator'

  export default {
    private: {
      // 告警类型
      alertType: 'posture_warning',

      // 显示内容
      alertTitle: '体态提醒',
      alertIcon: '⚠️',
      alertMainTitle: '请注意坐姿',
      alertDescription: '检测到您已保持不良坐姿超过30分钟，建议起身活动一下。',
      showDetails: true,
      details: [
        { label: '当前评分', value: '65分' },
        { label: '不良时长', value: '32分钟' },
        { label: '今日提醒', value: '第3次' }
      ],

      // AI建议
      aiAdvice: '🤖 建议：每30分钟起身活动5分钟，可以做简单的颈部旋转和肩部放松运动。',

      // 按钮
      primaryButtonText: '开始活动',
      secondaryButtonText: '稍后提醒',

      // 屏幕适配信息
      isRoundScreen: false,
      safeAreaTop: 20
    },

    onInit() {
      this.loadScreenInfo()
      this.parseParams()
      this.loadAlertContent()
    },

    // 加载屏幕信息
    loadScreenInfo() {
      const app = this.$app
      if (app && app.globalData && app.globalData.screen) {
        const screen = app.globalData.screen
        this.isRoundScreen = screen.isRound
        this.safeAreaTop = screen.safeAreaTop
      }
    },

    // 解析参数
    parseParams() {
      const params = this.params || {}
      if (params.type) {
        this.alertType = params.type
      }
      if (params.score) {
        this.details[0].value = `${params.score}分`
      }
    },

    // 加载告警内容
    loadAlertContent() {
      switch (this.alertType) {
        case 'posture_warning':
          this.loadPostureWarning()
          break
        case 'ai_advice':
          this.loadAIAdvice()
          break
        case 'goal_achieved':
          this.loadGoalAchieved()
          break
        case 'remind_break':
          this.loadRemindBreak()
          break
        default:
          break
      }
    },

    // 加载体态警告
    loadPostureWarning() {
      this.alertTitle = '体态提醒'
      this.alertIcon = '⚠️'
      this.alertMainTitle = '请注意坐姿'
      this.alertDescription = '检测到您已保持不良坐姿较长时间，建议调整坐姿或起身活动。'
      this.primaryButtonText = '调整坐姿'
      this.secondaryButtonText = '稍后提醒'

      // 震动提醒
      vibrator.vibrate({ mode: 'short', duration: 100 })
    },

    // 加载AI建议
    loadAIAdvice() {
      this.alertTitle = 'AI分析'
      this.alertIcon = '🤖'
      this.alertMainTitle = '体态分析报告'

      const app = this.$app
      if (app && app.globalData) {
        const data = app.globalData.todayData
        this.alertDescription = `今日体态评分：${data.score}分\n良好时间：${data.goodPostureMinutes}分钟\n不良时间：${data.badPostureMinutes}分钟`

        this.details = [
          { label: '今日评分', value: `${data.score}分` },
          { label: '良好时长', value: `${data.goodPostureMinutes}分钟` },
          { label: '不良时长', value: `${data.badPostureMinutes}分钟` },
          { label: '检测次数', value: `${data.totalChecks}次` }
        ]

        // 获取AI建议
        if (app.getAIAnalysis) {
          app.getAIAnalysis('分析我今天的体态数据并给出改善建议').then(advice => {
            this.aiAdvice = advice
          })
        }
      }

      this.primaryButtonText = '查看详情'
      this.secondaryButtonText = '返回'
    },

    // 加载目标达成
    loadGoalAchieved() {
      this.alertTitle = '恭喜'
      this.alertIcon = '🎉'
      this.alertMainTitle = '今日目标达成！'
      this.alertDescription = '您的体态评分已达到今日目标，继续保持良好的坐姿习惯！'
      this.aiAdvice = '🏆 太棒了！坚持良好的体态习惯，您的身体会感谢您的。'
      this.primaryButtonText = '查看成就'
      this.secondaryButtonText = '继续监测'
      this.showDetails = false
    },

    // 加载休息提醒
    loadRemindBreak() {
      this.alertTitle = '休息提醒'
      this.alertIcon = '☕'
      this.alertMainTitle = '该休息一下了'
      this.alertDescription = '您已连续工作较长时间，建议起身活动5-10分钟。'
      this.aiAdvice = '🧘 推荐动作：颈部旋转、肩部放松、手腕转动、站立伸展。'
      this.primaryButtonText = '开始休息'
      this.secondaryButtonText = '稍后提醒'
      this.showDetails = false
    },

    // 主按钮操作
    handlePrimaryAction() {
      switch (this.alertType) {
        case 'posture_warning':
          // 开始活动
          this.startActivity()
          break
        case 'ai_advice':
          // 查看详情
          router.push({ uri: '/pages/history' })
          break
        case 'goal_achieved':
          // 查看成就
          router.push({ uri: '/pages/history' })
          break
        case 'remind_break':
          // 开始休息
          this.startBreak()
          break
      }
    },

    // 次按钮操作
    handleSecondaryAction() {
      switch (this.alertType) {
        case 'posture_warning':
        case 'remind_break':
          // 稍后提醒
          this.remindLater()
          break
        case 'ai_advice':
        case 'goal_achieved':
          // 返回
          router.back()
          break
      }
    },

    // 开始活动
    startActivity() {
      // 实际项目中会启动活动模式
      console.log('开始活动')
      router.back()
    },

    // 开始休息
    startBreak() {
      // 实际项目中会启动休息模式
      console.log('开始休息')
      router.back()
    },

    // 稍后提醒
    remindLater() {
      // 实际项目中会设置稍后提醒
      console.log('稍后提醒')
      router.back()
    },

    // 返回
    goBack() {
      router.back()
    },

    // 手势处理
    handleSwipe(e) {
      if (e.direction === 'right') {
        router.back()
      }
    }
  }
</script>
