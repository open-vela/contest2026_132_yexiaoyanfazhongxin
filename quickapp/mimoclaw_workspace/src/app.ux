<template>
  <div class="app-container">
    <slot></slot>
  </div>
</template>

<style>
  .app-container {
    width: 466px;
    height: 466px;
    background-color: #0a0a0a;
    color: #ffffff;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }
</style>

<script>
  import storage from '@system.storage'
  import device from '@system.device'

  export default {
    // 全局数据
    globalData: {
      // 用户设置
      settings: {
        postureCheckInterval: 30,    // 检测间隔（分钟）
        dailyPostureScore: 80,       // 每日目标分数
        reminderEnabled: true,       // 提醒开关
        aiEnabled: true,             // AI分析开关
        vibrationIntensity: 'medium' // 震动强度
      },
      // 今日数据
      todayData: {
        score: 85,
        goodPostureMinutes: 0,
        badPostureMinutes: 0,
        totalChecks: 0,
        reminders: 0,
        lastCheckTime: null
      },
      // 历史数据（最近7天）
      weekData: [],
      // AI分析结果
      aiAnalysis: null,
      // 应用状态
      isMonitoring: false,
      currentTime: '',
      // 屏幕信息（自动检测）
      screen: {
        isRound: false,         // 是否圆屏
        width: 466,             // 屏幕宽度
        height: 466,            // 屏幕高度
        safePadding: 20,        // 安全边距
        safeAreaTop: 20,        // 顶部安全区域
        safeAreaBottom: 20,     // 底部安全区域
        safeAreaLeft: 20,       // 左侧安全区域
        safeAreaRight: 20       // 右侧安全区域
      }
    },

    onCreate() {
      console.log('App onCreate')
      this.detectScreen()
      this.loadSettings()
      this.loadTodayData()
      this.loadWeekData()
      this.startTimer()
    },

    // 自动检测屏幕类型
    detectScreen() {
      device.getInfo({
        success: (data) => {
          console.log('设备信息:', JSON.stringify(data))

          // 获取屏幕尺寸
          const screenWidth = data.screenWidth || 466
          const screenHeight = data.screenHeight || 466

          // 判断是否圆屏
          // 方式1: 通过 deviceInfo 中的 shape 字段判断
          // 方式2: 通过屏幕宽高比和设备型号判断
          // 方式3: 默认按方屏处理，如果宽高相同且没有明确的方形标识则视为圆屏
          let isRound = false

          if (data.shape === 'round') {
            isRound = true
          } else if (data.shape === 'square') {
            isRound = false
          } else {
            // 没有shape字段时，通过宽高比判断
            // 大多数圆屏手表是1:1的正方形分辨率
            isRound = (screenWidth === screenHeight)
          }

          // 根据屏幕类型设置安全边距
          let safePadding = 20
          let safeAreaTop = 20
          let safeAreaBottom = 20
          let safeAreaLeft = 20
          let safeAreaRight = 20

          if (isRound) {
            // 圆屏需要更大的安全边距，避免四角内容被裁切
            safePadding = Math.floor(screenWidth * 0.08) // 约8%的边距
            safeAreaTop = Math.floor(screenHeight * 0.1)  // 顶部10%
            safeAreaBottom = Math.floor(screenHeight * 0.1) // 底部10%
            safeAreaLeft = Math.floor(screenWidth * 0.08)   // 左侧8%
            safeAreaRight = Math.floor(screenWidth * 0.08)  // 右侧8%
          }

          // 更新全局屏幕信息
          this.globalData.screen = {
            isRound: isRound,
            width: screenWidth,
            height: screenHeight,
            safePadding: safePadding,
            safeAreaTop: safeAreaTop,
            safeAreaBottom: safeAreaBottom,
            safeAreaLeft: safeAreaLeft,
            safeAreaRight: safeAreaRight
          }

          console.log('屏幕类型:', isRound ? '圆屏' : '方屏')
          console.log('安全边距:', safePadding)
        },
        fail: (err) => {
          console.error('获取设备信息失败:', err)
          // 失败时使用默认方屏配置
          this.globalData.screen = {
            isRound: false,
            width: 466,
            height: 466,
            safePadding: 20,
            safeAreaTop: 20,
            safeAreaBottom: 20,
            safeAreaLeft: 20,
            safeAreaRight: 20
          }
        }
      })
    },

    onDestroy() {
      console.log('App onDestroy')
      this.saveTodayData()
    },

    // 加载设置
    loadSettings() {
      storage.get({
        key: 'settings',
        success: (data) => {
          if (data) {
            this.globalData.settings = JSON.parse(data)
          }
        },
        fail: (err) => {
          console.error('加载设置失败:', err)
        }
      })
    },

    // 保存设置
    saveSettings() {
      storage.set({
        key: 'settings',
        value: JSON.stringify(this.globalData.settings),
        success: () => {
          console.log('设置已保存')
        },
        fail: (err) => {
          console.error('保存设置失败:', err)
        }
      })
    },

    // 加载今日数据
    loadTodayData() {
      const today = this.getDateKey()
      storage.get({
        key: `data_${today}`,
        success: (data) => {
          if (data) {
            this.globalData.todayData = JSON.parse(data)
          }
        },
        fail: () => {
          // 今日无数据，使用默认值
          this.globalData.todayData = {
            score: 85,
            goodPostureMinutes: 0,
            badPostureMinutes: 0,
            totalChecks: 0,
            reminders: 0,
            lastCheckTime: null
          }
        }
      })
    },

    // 保存今日数据
    saveTodayData() {
      const today = this.getDateKey()
      storage.set({
        key: `data_${today}`,
        value: JSON.stringify(this.globalData.todayData),
        success: () => {
          console.log('今日数据已保存')
        }
      })
    },

    // 加载本周数据
    loadWeekData() {
      storage.get({
        key: 'week_data',
        success: (data) => {
          if (data) {
            this.globalData.weekData = JSON.parse(data)
          }
        }
      })
    },

    // 保存本周数据
    saveWeekData() {
      storage.set({
        key: 'week_data',
        value: JSON.stringify(this.globalData.weekData)
      })
    },

    // 获取日期键
    getDateKey() {
      const now = new Date()
      return `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`
    },

    // 启动计时器
    startTimer() {
      setInterval(() => {
        const now = new Date()
        this.globalData.currentTime = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`
      }, 1000)
    },

    // 更新体态数据
    updatePostureData(isGoodPosture) {
      const data = this.globalData.todayData
      data.totalChecks++

      if (isGoodPosture) {
        data.goodPostureMinutes += this.globalData.settings.postureCheckInterval
      } else {
        data.badPostureMinutes += this.globalData.settings.postureCheckInterval
        data.reminders++
      }

      // 计算分数
      const totalMinutes = data.goodPostureMinutes + data.badPostureMinutes
      if (totalMinutes > 0) {
        data.score = Math.round((data.goodPostureMinutes / totalMinutes) * 100)
      }

      data.lastCheckTime = new Date().toLocaleTimeString()
      this.saveTodayData()
    },

    // 获取AI分析
    getAIAnalysis(question) {
      return new Promise((resolve, reject) => {
        if (!this.globalData.settings.aiEnabled) {
          resolve('AI分析已关闭')
          return
        }

        const fetch = require('@system.fetch')
        const data = this.globalData.todayData
        const settings = this.globalData.settings

        const systemPrompt = `你是一个运行在智能手表上的AI体态守护助手。
当前时间：${this.globalData.currentTime}
今日体态评分：${data.score}分
良好体态时间：${data.goodPostureMinutes}分钟
不良体态时间：${data.badPostureMinutes}分钟
检测次数：${data.totalChecks}次
提醒次数：${data.reminders}次

请用简短的语言回复（手表屏幕小），优先使用表情符号辅助表达。
当用户询问体态问题时，结合数据分析给出具体建议。`

        fetch.fetch({
          url: this.globalData.aiEndpoint || 'https://api.moonshot.cn/v1/chat/completions',
          method: 'POST',
          header: { 'Content-Type': 'application/json' },
          data: JSON.stringify({
            model: this.globalData.aiModel || 'kimi-k2.5',
            messages: [
              { role: 'system', content: systemPrompt },
              { role: 'user', content: question }
            ],
            max_tokens: 200,
            temperature: 0.7
          }),
          success: (res) => {
            const result = JSON.parse(res.data)
            resolve(result.choices[0].message.content)
          },
          fail: (err) => {
            reject(err)
          }
        })
      })
    },

    // 获取体态建议
    getPostureAdvice() {
      const data = this.globalData.todayData
      let advice = ''

      if (data.score >= 90) {
        advice = '🎉 体态优秀！继续保持！'
      } else if (data.score >= 70) {
        advice = '👍 体态良好，还可以更好！'
      } else if (data.score >= 50) {
        advice = '⚠️ 体态一般，需要注意坐姿'
      } else {
        advice = '🚨 体态较差，请立即调整坐姿！'
      }

      return advice
    }
  }
</script>
