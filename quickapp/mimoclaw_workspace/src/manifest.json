{
  "package": "com.example.postureguard",
  "name": "体态守护",
  "versionName": "1.0.0",
  "versionCode": 1,
  "minPlatformVersion": 1070,
  "icon": "/common/icons/logo.png",
  "deviceTypeList": ["phone", "watch"],
  "features": [
    { "name": "system.router" },
    { "name": "system.fetch" },
    { "name": "system.storage" },
    { "name": "system.sensor" },
    { "name": "system.vibrator" },
    { "name": "system.device" },
    { "name": "system.battery" },
    { "name": "system.prompt" }
  ],
  "permissions": [
    { "origin": "*" }
  ],
  "config": {
    "target": "vela",
    "output": "dist",
    "minify": true,
    "designWidth": 466
  },
  "router": {
    "entry": "pages/home",
    "pages": {
      "pages/home": { "component": "home" },
      "pages/settings": { "component": "settings" },
      "pages/history": { "component": "history" },
      "pages/alert": { "component": "alert" }
    }
  },
  "display": {
    "titleBar": false,
    "menu": false,
    "fullScreen": true
  },
  "data": {
    "aiEndpoint": "https://api.moonshot.cn/v1/chat/completions",
    "aiModel": "kimi-k2.5",
    "defaultGoal": {
      "postureCheckInterval": 30,
      "dailyPostureScore": 80,
      "reminderEnabled": true
    }
  }
}
